# Names only. Never commit real credentials; set production values in Railway.
NEXT_PUBLIC_SITE_URL=https://einvoicecheck.ae
NEXT_PUBLIC_API_BASE_URL=https://api.einvoicecheck.ae
NEXT_PUBLIC_SLA_MODE=beta
WAITLIST_STORE_PATH=./data/waitlist.jsonl
NEXT_PUBLIC_GSC_VERIFICATION=

# Server-side API key used by the free converter tool (/api/tools/convert)
# to authenticate against the paid POST /v1/convert API. Must match a key
# issued on the API service. Never expose to the browser.
EINVOICECHECK_API_KEY=

MONGODB_URI=
REDIS_URL=
AUTH_SECRET=

# Free-validator abuse controls. Use a unique random salt and set
# TOOL_RATE_LIMIT_REQUIRE_REDIS=true in Railway production.
TOOL_RATE_LIMIT_PER_HOUR=20
TOOL_RATE_LIMIT_REQUIRE_REDIS=false
TOOL_RATE_LIMIT_SALT=

# PayPal Subscriptions. Start in sandbox and switch only after end-to-end testing.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_PLAN_ID_STARTER=
PAYPAL_PLAN_ID_PRO=
PAYPAL_RETURN_URL=https://einvoicecheck.ae/dashboard?checkout=success
PAYPAL_CANCEL_URL=https://einvoicecheck.ae/dashboard?checkout=cancelled

PORT=3000
