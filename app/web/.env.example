# einvoicecheck.ae marketing site - environment variable NAMES only.
# Never commit real values. Set these in Railway (project: einvoicecheck.ae, env: production).

# Public canonical origin used for canonical URLs, OG tags, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://einvoicecheck.ae

# Public base URL of the validation API (app/api, deployed separately on Railway).
NEXT_PUBLIC_API_BASE_URL=

# Where the waitlist API route persists signups.
# TODO(E2): replace the file-backed stub with the real datastore used by auth + billing.
WAITLIST_STORE_PATH=./data/waitlist.jsonl

# Google Search Console DNS-TXT verification is done at the registrar, not here.
# If you later switch to the HTML-tag method, put the token in this variable.
NEXT_PUBLIC_GSC_VERIFICATION=

# Datastores shared with app/api (same Mongo database, same Redis instance).
MONGODB_URI=
REDIS_URL=

# Session cookie signing for the dashboard. REQUIRED in production (32+ random bytes).
AUTH_SECRET=

# --- Dodo Payments (merchant of record). Names only - never put secrets here. ---
# Operator steps to fill these: handoffs/E2/DODO_SETUP.md
DODO_PAYMENTS_API_KEY=              # secret - test-mode key until individual KYC clears
DODO_PAYMENTS_WEBHOOK_KEY=          # secret - webhook signing secret (whsec_...)
DODO_PAYMENTS_ENVIRONMENT=test_mode # 'test_mode' | 'live_mode'; the code DEFAULTS to test_mode
DODO_PRODUCT_ID_TRIAL=              # product_id for the free trial
DODO_PRODUCT_ID_STARTER=            # product_id for the $29 tier
DODO_PRODUCT_ID_PRO=                # product_id for the $99 tier
DODO_RETURN_URL=https://einvoicecheck.ae/dashboard?checkout=success

PORT=3000
