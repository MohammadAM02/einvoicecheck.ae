}
.pricing-period {
  font-size: 14px;
  color: var(--ink-muted);
  margin-bottom: var(--space-lg);
}
.pricing-usage {
  font-size: 14px;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: var(--space-md);
}
.pricing-features {
  list-style: none;
  margin-bottom: var(--space-xl);
}
.pricing-features li {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  font-size: 14px;
  color: var(--ink-secondary);
  line-height: 1.5;
  padding: 6px 0;
}
.pricing-features li::before {
  content: '→';
  color: var(--accent);
  font-weight: 600;
  flex-shrink: 0;
}
.pricing-card .btn {
  width: 100%;
  justify-content: center;
}

/* ============================================================
   USAGE PATTERNS / FEATURE ITEMS
   ============================================================ */
.usage-list {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-lg);
}
.usage-item {
  display: flex;
  align-items: flex-start;
  gap: var(--space-md);
  padding: var(--space-lg);
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  transition: border-color 0.2s, transform 0.2s;
}
.usage-item:hover {
  border-color: var(--accent);
  transform: translateY(-2px);
}
.usage-item .icon {
  font-size: 20px;
  line-height: 1;
  margin-top: 2px;
  flex-shrink: 0;
}
.usage-item h4 {
  font-family: var(--font-heading);
  font-size: 16px;
  font-weight: 600;
  margin-bottom: 4px;
}
.usage-item p {
  font-size: 14px;
  color: var(--ink-secondary);
  line-height: 1.5;
  margin-bottom: 0;
}

/* ============================================================
   SOCIAL PROOF
   ============================================================ */
.proof-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--space-xl);
}
.proof-card {
  text-align: center;
  padding: var(--space-xl) var(--space-lg);
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  transition: border-color 0.2s;
}
.proof-card:hover { border-color: var(--accent); }
.proof-number {
  font-family: var(--font-heading);
  font-size: 36px;
  font-weight: 700;
  color: var(--accent);
  letter-spacing: -0.8px;
}
.proof-label {
  font-size: 13px;
  color: var(--ink-muted);
  margin-top: var(--space-sm);
}

/* ============================================================
   PAYMENT METHOD BADGES (customer-facing — we route through Lemon)
   ============================================================ */
.payment-methods {
  display: flex;
  gap: var(--space-sm);
  justify-content: center;
  align-items: center;
  margin-bottom: var(--space-lg);
  flex-wrap: wrap;
}
.payment-method-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 14px;
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  background: var(--bg-elevated);
  color: var(--ink-secondary);
  font-size: 13px;
  font-weight: 500;
}
.payment-method-badge .pm-icon { font-size: 16px; }

/* ============================================================
   TOOL — invoice validator textarea + results
   ============================================================ */
.tool-input {
  display: block;
  width: 100%;
  padding: 14px 16px;
  border-radius: var(--radius-md);
  border: 1px solid var(--border);
  background: var(--bg);
  color: var(--ink);
  font-family: var(--font-code);
  font-size: 13px;
  line-height: 1.6;
  resize: vertical;
  min-height: 260px;
  transition: border-color 0.2s, box-shadow 0.2s;
}
.tool-input:focus {
  outline: none;
  border-color: var(--accent);
  box-shadow: 0 0 0 3px var(--accent-subtle);
}
.tool-input::placeholder {
  color: var(--ink-disabled);
}

.badge.ok {
  background: var(--success-subtle);
  color: var(--success);
  border-color: rgba(52, 211, 153, 0.3);
}
.badge.bad {
  background: var(--error-subtle);
  color: var(--error);
  border-color: rgba(248, 113, 113, 0.3);
}

.btn-copy {
  font-size: 12px;
  padding: 4px 12px;
}

/* ---- SAMPLE DROPDOWN — template picker for the validator ---- */
.sample-btn-wrapper {
  position: relative;
}
.sample-dropdown {
  position: absolute;
  top: calc(100% + 6px);
  left: 0;
  min-width: 380px;
  max-width: 90vw;
  max-height: 400px;
  overflow-y: auto;
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  box-shadow: 0 12px 48px rgba(0,0,0,0.4);
  z-index: 50;
  padding: 6px 0;
}
.sample-dropdown-header {
  padding: 8px 14px 4px;
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 1px;
  color: var(--ink-muted);
}
.sample-option {
  display: block;
  width: 100%;
  padding: 10px 14px;
  cursor: pointer;
  transition: background 0.15s;
  text-align: left;
  border: none;
  background: none;
  font-family: var(--font-body);
}
.sample-option:hover {
  background: var(--accent-subtle);
}
.sample-option-label {
  display: block;
  font-size: 14px;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 2px;
}
.sample-option-desc {
  display: block;
  font-size: 12px;
  color: var(--ink-muted);
  line-height: 1.4;
}
.sample-option-json {
  border-bottom: 1px solid var(--border);
}
.sample-divider {
  height: 1px;
  background: var(--border);
  margin: 4px 0;
}

.fix-list { margin-top: var(--space-md); }
.fix-row {
  padding: 14px 16px;
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  margin-bottom: var(--space-sm);
  background: var(--bg-elevated);
}
.fix-row.fix-row-error { border-left: 3px solid var(--error); }
.fix-row.fix-row-warning { border-left: 3px solid var(--warn); }
.fix-row-head {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  flex-wrap: wrap;
  margin-bottom: var(--space-xs);
}
.fix-rule {
  font-family: var(--font-code);
  font-size: 12px;
}
.fix-message {
  font-size: 14px;
  color: var(--ink-secondary);
  margin-bottom: var(--space-sm);
}
.fix-callout {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  padding: 10px 14px;
  background: var(--accent-subtle);
  border-radius: var(--radius-sm);
  font-size: 13px;
  flex-wrap: wrap;
}
.fix-callout-label {
  font-weight: 600;
  color: var(--accent);
  text-transform: uppercase;
  font-size: 11px;
  letter-spacing: 0.5px;
}
.fix-callout-text {
  color: var(--ink);
  font-family: var(--font-code);
  font-size: 12px;
  flex: 1;
}

/* ============================================================
   RESPONSIVE
   ============================================================ */
@media (max-width: 1024px) {
  .hero-grid { grid-template-columns: 1fr; gap: var(--space-2xl); }
  .hero h1 { font-size: 42px; }
  .hero-right { display: none; }
  .pricing-grid { grid-template-columns: 1fr; max-width: 480px; margin: 0 auto; }
  .pricing-card.featured { transform: none; }
  .pricing-card.featured:hover { transform: translateY(-3px); }
  .grid-3 { grid-template-columns: 1fr; }
  .grid-4, .proof-grid { grid-template-columns: 1fr 1fr; }
  .usage-list { grid-template-columns: 1fr; }
  .footer-grid { grid-template-columns: 1fr 1fr; gap: var(--space-xl); }
  .footer-brand { grid-column: 1 / -1; }
}

@media (max-width: 640px) {
  .hero h1 { font-size: 32px; }
  .hero { padding: var(--space-3xl) 0 var(--space-2xl); }
  section, .section { padding: var(--space-2xl) 0; }
  .section-title { font-size: 26px; }
  h2 { font-size: 24px; }
  .hero-actions { flex-direction: column; align-items: stretch; }
  .hero-actions .btn { justify-content: center; }
  .hero-stats { flex-direction: column; gap: var(--space-lg); }
  .grid-2, .grid-4, .proof-grid { grid-template-columns: 1fr; }
  header.site nav { display: none; }
  .footer-grid { grid-template-columns: 1fr 1fr; }
  .footer-bottom { flex-direction: column; align-items: flex-start; }
}
