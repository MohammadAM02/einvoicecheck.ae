<file path="api/src/db/mongoose.js">
import mongoose from 'mongoose';
import { config } from '../config/env.js';

/**
 * Connect the global mongoose instance. Idempotent — if a connection is
 * already open (e.g. established by the test harness against
 * mongodb-memory-server) it is reused.
 */
export async function connectMongo(uri = config.mongoUri) {
  if (mongoose.connection.readyState === 1) return mongoose.connection;
  mongoose.set('strictQuery', true);
  await mongoose.connect(uri, {
    serverSelectionTimeoutMS: 5_000,
  });
  return mongoose.connection;
}

export async function disconnectMongo() {
  if (mongoose.connection.readyState !== 0) {
    await mongoose.disconnect();
  }
}

/** readyState === 1 means connected. Used by the /health readiness probe. */
export function mongoIsUp() {
  return mongoose.connection.readyState === 1;
}
</file>

<file path="api/src/db/redis.js">
import Redis from 'ioredis';
import { config } from '../config/env.js';

/**
 * Create a real ioredis client. In tests we inject an ioredis-mock instance
 * into buildApp() instead of calling this, so no live Redis is required.
 *
 * lazyConnect keeps construction cheap; we connect explicitly in server.js.
 */
export function createRedis(url = config.redisUrl) {
  const client = new Redis(url, {
    lazyConnect: true,
    maxRetriesPerRequest: 2,
    enableReadyCheck: true,
  });
  // Avoid crashing the process on transient Redis errors; the /health probe
  // and rate-limiter surface connectivity problems instead.
  client.on('error', () => {});
  return client;
}

/**
 * Liveness check for the /health readiness probe. Returns true if PING
 * succeeds within a short budget. Works for both ioredis and ioredis-mock.
 */
export async function redisIsUp(client) {
  if (!client) return false;
  try {
    const pong = await client.ping();
    return pong === 'PONG';
  } catch {
    return false;
  }
}
</file>

<file path="api/src/models/ApiKey.js">
import mongoose from 'mongoose';
import crypto from 'node:crypto';

/**
 * API key record. The raw key is never stored — only its SHA-256 hash.
 * Raw keys have the form `pdk_live_<32 hex chars>` and are shown to the
 * operator exactly once (at seed time).
 */
const apiKeySchema = new mongoose.Schema(
  {
    name: { type: String, required: true },
    keyHash: { type: String, required: true, unique: true, index: true },
    prefix: { type: String, required: true }, // first chars, for display only
    active: { type: Boolean, default: true, index: true },
    rateLimitPerMinute: { type: Number, default: null }, // null => use global default
    lastUsedAt: { type: Date, default: null },
  },
  { timestamps: true, collection: 'api_keys' }
);

apiKeySchema.statics.hashKey = function hashKey(rawKey) {
  return crypto.createHash('sha256').update(rawKey).digest('hex');
};

/** Generate a fresh raw key + its persisted fields. Raw is returned once. */
apiKeySchema.statics.generate = function generate({ name, rateLimitPerMinute = null }) {
  const raw = `pdk_live_${crypto.randomBytes(16).toString('hex')}`;
  return {
    raw,
    doc: {
      name,
      keyHash: this.hashKey(raw),
      prefix: raw.slice(0, 12),
      rateLimitPerMinute,
      active: true,
    },
  };
};

export const ApiKey =
  mongoose.models.ApiKey || mongoose.model('ApiKey', apiKeySchema);
</file>

