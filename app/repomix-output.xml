<file path="api/src/routes/health.js">
import { mongoIsUp } from '../db/mongoose.js';
import { redisIsUp } from '../db/redis.js';

/**
 * Liveness + readiness. The process being able to answer is liveness; the
 * dependency checks (Mongo + Redis) are readiness. Returns 503 when a
 * dependency is down so orchestrators can gate traffic.
 */
export async function healthRoutes(fastify) {
  fastify.get(
    '/health',
    {
      schema: {
        tags: ['ops'],
        summary: 'Liveness/readiness probe (checks Mongo + Redis connectivity).',
        response: {
          200: { $ref: 'HealthReply#' },
          503: { $ref: 'HealthReply#' },
        },
      },
    },
    async (request, reply) => {
      const [redisOk] = await Promise.all([redisIsUp(fastify.redis)]);
      const mongoOk = mongoIsUp();
      const ready = mongoOk && redisOk;
      const body = {
        status: ready ? 'ok' : 'degraded',
        live: true,
        checks: {
          mongo: mongoOk ? 'up' : 'down',
          redis: redisOk ? 'up' : 'down',
        },
        timestamp: new Date().toISOString(),
      };
      return reply.code(ready ? 200 : 503).send(body);
    }
  );
}
</file>

<file path="api/src/routes/usage.js">
import { authenticate } from '../plugins/security.js';
import { UsageEvent } from '../models/UsageEvent.js';

/**
 * Per-API-key usage, aggregated from the metering events in Mongo.
 * Returns lifetime + trailing-30-day + today counts, an outcome breakdown,
 * and the most recent events.
 */
export async function usageRoutes(fastify) {
  fastify.get(
    '/usage',
    {
      preHandler: [authenticate],
      schema: {
        tags: ['usage'],
        summary: 'Usage metering for the calling API key.',
        security: [{ apiKey: [] }, { bearerAuth: [] }],
        response: {
          200: { $ref: 'UsageReply#' },
          401: { $ref: 'ErrorReply#' },
        },
      },
    },
    async (request, reply) => {
      const keyId = request.apiKey._id;
      const now = new Date();
      const startOfToday = new Date(now.getFullYear(), now.getMonth(), now.getDate());
      const start30d = new Date(now.getTime() - 30 * 24 * 60 * 60 * 1000);

      const [total, today, last30d, byOutcome, recent] = await Promise.all([
        UsageEvent.countDocuments({ keyId }),
        UsageEvent.countDocuments({ keyId, timestamp: { $gte: startOfToday } }),
        UsageEvent.countDocuments({ keyId, timestamp: { $gte: start30d } }),
        UsageEvent.aggregate([
          { $match: { keyId } },
          { $group: { _id: '$outcome', count: { $sum: 1 } } },
        ]),
        UsageEvent.find({ keyId }).sort({ timestamp: -1 }).limit(10).lean(),
      ]);

      const outcomes = { valid: 0, invalid: 0, error: 0 };
      for (const row of byOutcome) {
        if (row._id in outcomes) outcomes[row._id] = row.count;
      }

      return reply.code(200).send({
        keyPrefix: request.apiKey.prefix,
        keyName: request.apiKey.name,
        totals: { allTime: total, today, last30Days: last30d },
        outcomes,
        recent: recent.map((e) => ({
          endpoint: e.endpoint,
          method: e.method,
          outcome: e.outcome,
          statusCode: e.statusCode,
          timestamp: e.timestamp,
        })),
      });
    }
  );
}
</file>

<file path="api/src/routes/validate.js">
import { validateInvoice } from '../rules/engine.js';
import { authenticate, makeRateLimiter } from '../plugins/security.js';
import { UsageEvent } from '../models/UsageEvent.js';

const errorObjectSchema = {
  type: 'object',
  properties: {
    path: { type: 'string' },
    rule: { type: 'string' },
    severity: { type: 'string', enum: ['error', 'warning'] },
    message: { type: 'string' },
    fix: { type: 'string' },
  },
  required: ['path', 'rule', 'severity', 'message'],
};

const resultSchema = {
  type: 'object',
  properties: {
    valid: { type: 'boolean' },
    invoiceType: { type: ['string', 'null'] },
    schemaVersion: { type: 'string' },
    errors: { type: 'array', items: errorObjectSchema },
  },
  required: ['valid', 'invoiceType', 'schemaVersion', 'errors'],
};

/**
 * Write a best-effort usage-metering event. Never throws into the request path.
 */
async function meter(request, statusCode, outcome) {
  try {
    if (!request.apiKey) return;
    await UsageEvent.create({
      keyId: request.apiKey._id,
      endpoint: '/v1/validate',
      method: 'POST',
      statusCode,
      outcome,
    });
  } catch (e) {
    request.log.warn({ err: e }, 'failed to write usage event');
  }
}

export async function validateRoutes(fastify) {
  const rateLimit = makeRateLimiter(fastify);

  fastify.post(
    '/v1/validate',
    {
      preHandler: [authenticate, rateLimit],
      // Accept JSON canonical invoices, an { document: "<xml>" } envelope,
      // or raw XML (see the text/xml content-type parser in app.js).
      config: { rawBody: false },
      schema: {
        tags: ['validation'],
        summary: 'Preflight-validate a UAE invoice (JSON or UBL 2.1 / PINT AE XML).',
        description:
          'Deterministic preflight validation only. Does NOT transmit a legal e-invoice, is NOT FTA-accredited, and does not replace an accredited ASP or provide statutory archival. ' +
          'Send a canonical JSON invoice, an envelope { "document": "<Invoice>..." }, or raw UBL/PINT AE XML with Content-Type application/xml.',
        security: [{ apiKey: [] }, { bearerAuth: [] }],
        response: {
          200: resultSchema,
          401: { $ref: 'ErrorReply#' },
          429: { $ref: 'ErrorReply#' },
        },
      },
    },
    async (request, reply) => {
      const contentType = request.headers['content-type'] || '';
      const result = validateInvoice(request.body, contentType);
      const outcome = result.errors.some((e) => e.rule === 'ENG-PARSE-01')
        ? 'error'
        : result.valid
          ? 'valid'
          : 'invalid';
      await meter(request, 200, outcome);
      return reply.code(200).send(result);
    }
  );
}
</file>

<file path="api/src/rules/checks/currency.js">
import { err, warn } from '../error.js';
import { DOMESTIC_CURRENCY, ISO4217_RE } from '../codelists.js';

/**
 * Currency presence, ISO 4217 shape, and the UAE requirement that VAT be
 * accounted in AED.
 *
 * Cites: PINT AE IBR-005 / IBR-CL-04 (DocumentCurrencyCode must be a valid
 * ISO 4217 alpha-3 code); UAE Guidelines v1.1 — VAT amounts must be reported
 * in AED, and a tax accounting currency (AED) is required when the invoice
 * currency is not AED (PINT IBR-053 / IBR-077).
 */
export const currencyRule = {
  id: 'ENG-CUR-01',
  spec: 'IBR-005 / IBR-CL-04 / IBR-053 / IBR-077 (PINT AE); AED accounting',
  description: 'Document currency present + ISO 4217; AED tax currency when invoice currency is not AED.',
  evaluate(inv) {
    const out = [];
    const cur = inv.currency;
    if (!cur) {
      out.push(
        err('/currency', 'ENG-CUR-01/IBR-005',
          'Document currency code (BT-5) is missing.',
          'Provide a currency, e.g. "AED".')
      );
      return out;
    }
    if (!ISO4217_RE.test(String(cur))) {
      out.push(
        err('/currency', 'ENG-CUR-02/IBR-CL-04',
          `Currency "${cur}" is not a valid ISO 4217 alpha-3 code.`,
          'Use a 3-letter uppercase code such as "AED".')
      );
    }
    if (cur !== DOMESTIC_CURRENCY) {
      // Foreign-currency invoice: VAT must still be accounted in AED.
      if (inv.taxCurrency !== DOMESTIC_CURRENCY) {
        out.push(
          err('/taxCurrency', 'ENG-CUR-03/IBR-053',
            `Invoice currency is "${cur}" but the tax accounting currency is not AED.`,
            'Set taxCurrency to "AED" and report VAT amounts in AED (BT-6).')
        );
      } else {
        out.push(
          warn('/currency', 'ENG-CUR-04',
            `Invoice currency is "${cur}" (non-AED). Ensure the AED VAT accounting amount and exchange rate are supplied.`,
            'Confirm taxCurrency "AED" and the applicable FTA exchange rate.')
        );
      }
    }
    return out;
  },
};
</file>

<file path="api/src/rules/checks/documentTotals.js">
import { err } from '../error.js';
import { moneyEq, round2, isNumber, fmt } from '../money.js';

/**
 * Document-level total arithmetic. Rule IDs below are the PINT AE / EN 16931
 * calculation rules confirmed from the PINT AE business-rule set
 * (https://docs.peppol.eu/poac/ae/v1.0.1/pint-ae/trn-invoice/businessrule/):
 *
 *   IBR-CO-10  sum of line net (ibt-106) = Σ line net (ibt-131)
 *   IBR-CO-13  total w/o tax (ibt-109)  = ibt-106 - allowances (ibt-107) + charges (ibt-108)
 *   IBR-CO-14  total tax (ibt-110)      = Σ tax category tax amount (ibt-117)
 *   IBR-CO-15  total w/ tax (ibt-112)   = ibt-109 + ibt-110
 *   IBR-CO-16  amount due (ibt-115)     = ibt-112 - prepaid (ibt-113) + rounding (ibt-114)
 */
export const documentTotalsRule = {
  id: 'ENG-TOT-01',
  spec: 'IBR-CO-10/13/14/15/16 (PINT AE)',
  description: 'Document totals reconcile: line sum, tax-exclusive, tax, tax-inclusive and payable amounts.',
  evaluate(inv) {
    const out = [];
    const t = inv.totals || {};
    const lines = inv.lines || [];
    const subtotals = inv.taxSubtotals || [];

    // IBR-CO-10
    if (isNumber(t.lineExtensionAmount) && lines.every((l) => isNumber(l.lineExtensionAmount))) {
      const sum = round2(lines.reduce((s, l) => s + Number(l.lineExtensionAmount), 0));
      if (!moneyEq(sum, t.lineExtensionAmount)) {
        out.push(err('/totals/lineExtensionAmount', 'ENG-TOT-10/IBR-CO-10',
          `Sum of line net amounts (BT-106) ${fmt(t.lineExtensionAmount)} does not equal Σ line nets (${fmt(sum)}).`,
          `Set totals.lineExtensionAmount to ${fmt(sum)}.`));
      }
    }

    // IBR-CO-13
    if (isNumber(t.lineExtensionAmount) && isNumber(t.taxExclusiveAmount)) {
      const expected = round2(
        Number(t.lineExtensionAmount) - Number(inv.allowanceTotal || 0) + Number(inv.chargeTotal || 0)
      );
      if (!moneyEq(expected, t.taxExclusiveAmount)) {
        out.push(err('/totals/taxExclusiveAmount', 'ENG-TOT-13/IBR-CO-13',
          `Tax-exclusive amount (BT-109) ${fmt(t.taxExclusiveAmount)} does not equal line sum - allowances + charges (${fmt(expected)}).`,
          `Set totals.taxExclusiveAmount to ${fmt(expected)}.`));
      }
    }

    // IBR-CO-14
    if (isNumber(t.taxAmount) && subtotals.length && subtotals.every((s) => isNumber(s.taxAmount))) {
      const sum = round2(subtotals.reduce((s, st) => s + Number(st.taxAmount), 0));
      if (!moneyEq(sum, t.taxAmount)) {
        out.push(err('/totals/taxAmount', 'ENG-TOT-14/IBR-CO-14',
          `Invoice total tax (BT-110) ${fmt(t.taxAmount)} does not equal Σ tax subtotal amounts (${fmt(sum)}).`,
          `Set totals.taxAmount to ${fmt(sum)}.`));
      }
    }

    // IBR-CO-15
    if (isNumber(t.taxExclusiveAmount) && isNumber(t.taxAmount) && isNumber(t.taxInclusiveAmount)) {
      const expected = round2(Number(t.taxExclusiveAmount) + Number(t.taxAmount));
      if (!moneyEq(expected, t.taxInclusiveAmount)) {
        out.push(err('/totals/taxInclusiveAmount', 'ENG-TOT-15/IBR-CO-15',
          `Tax-inclusive amount (BT-112) ${fmt(t.taxInclusiveAmount)} does not equal tax-exclusive + tax (${fmt(expected)}).`,
          `Set totals.taxInclusiveAmount to ${fmt(expected)}.`));
      }
    }

    // IBR-CO-16
    if (isNumber(t.taxInclusiveAmount) && isNumber(t.payableAmount)) {
      const expected = round2(
        Number(t.taxInclusiveAmount) - Number(inv.prepaidAmount || 0) + Number(inv.roundingAmount || 0)
      );
      if (!moneyEq(expected, t.payableAmount)) {
        out.push(err('/totals/payableAmount', 'ENG-TOT-16/IBR-CO-16',
          `Amount due (BT-115) ${fmt(t.payableAmount)} does not equal tax-inclusive - prepaid + rounding (${fmt(expected)}).`,
          `Set totals.payableAmount to ${fmt(expected)}.`));
      }
    }

    return out;
  },
};
</file>

