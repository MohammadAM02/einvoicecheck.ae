<file path="web/src/app/api/templates/[filename]/route.ts">
import { NextRequest, NextResponse } from 'next/server';
import { readFileSync } from 'fs';
import { join } from 'path';

export const runtime = 'nodejs';
export const dynamic = 'force-dynamic';

/**
 * GET /api/templates/[filename]
 *
 * Serves a template XML file by reading it from public/templates/ directly.
 * This is more reliable than relying on Next.js standalone static file serving,
 * which can be inconsistent in Docker/Railway environments.
 *
 * Response: the XML file content with application/xml Content-Type.
 */
export async function GET(
  _request: NextRequest,
  { params }: { params: Promise<{ filename: string }> }
): Promise<NextResponse> {
  const { filename } = await params;

  // Prevent directory traversal
  if (filename.includes('..') || filename.includes('/') || filename.includes('\\')) {
    return NextResponse.json(
      { ok: false, error: 'Invalid filename' },
      { status: 400 }
    );
  }

  // Must end with .xml
  if (!filename.toLowerCase().endsWith('.xml')) {
    return NextResponse.json(
      { ok: false, error: 'Only XML files are served' },
      { status: 400 }
    );
  }

  try {
    // Try multiple paths: first standalone (Docker), then dev (source)
    const paths = [
      join(process.cwd(), 'public', 'templates', filename),
      join(process.cwd(), '.next', 'standalone', 'public', 'templates', filename),
    ];

    let content: string | null = null;
    let usedPath: string | null = null;

    for (const p of paths) {
      try {
        content = readFileSync(p, 'utf-8');
        usedPath = p;
        break;
      } catch {
        // try next path
      }
    }

    if (content === null) {
      return NextResponse.json(
        { ok: false, error: 'Template file not found' },
        { status: 404 }
      );
    }

    return new NextResponse(content, {
      status: 200,
      headers: {
        'Content-Type': 'application/xml; charset=utf-8',
        'Content-Disposition': `attachment; filename="${filename}"`,
        'Cache-Control': 'public, max-age=3600',
      },
    });
  } catch {
    return NextResponse.json(
      { ok: false, error: 'Failed to read template file' },
      { status: 500 }
    );
  }
}
</file>

<file path="web/src/app/api/templates/route.ts">
import { NextResponse } from 'next/server';

export const runtime = 'nodejs';
export const dynamic = 'force-dynamic';

/**
 * GET /api/templates
 *
 * Returns the list of available invoice template files.
 * The 16 XML files live in public/templates/ and Next.js serves them
 * as static assets at /templates/<filename>. We hardcode the metadata
 * here to avoid any filesystem path resolution issues in production.
 *
 * Response:
 *   { ok: true, templates: [{ filename, name, description }] }
 */

type TemplateMeta = { filename: string; name: string; description: string };

function displayName(filename: string): string {
  const name = filename.replace(/\.xml$/i, '');
  const spaced = name.replace(/\s+[-–]\s+/g, ' \u2014 ');
  return spaced.replace(/(^|\s|[-—])(\w)/g, (_, sep, ch) => sep + ch.toUpperCase());
}

const TEMPLATE_INFO: Record<string, string> = {
  'Commercial invoice.xml':
    'A commercial invoice for cross-border or domestic trade where no VAT is charged. Used when the supplier issues a commercial document rather than a full tax invoice.',
  'Continuous supplies.xml':
    'For ongoing contracts where goods or services are supplied continuously (e.g., subscriptions, utilities). Supports periodic invoicing without repeating the full setup each period.',
  'Deemed supply - predefined endpoint.xml':
    'Used when the FTA deems a supply to have occurred — e.g., private use of business assets, goods on hand at deregistration, or transfers without consideration.',
  'Disclosed agent billing.xml':
    'Issued by an agent who discloses their principal on the invoice. The invoice shows both the agent and the underlying principal/supplier.',
  'Exports - predefined endpoint.xml':
    'For exports where the goods leave the UAE and the customer is outside the UAE. Uses the predefined export endpoint with zero-rated VAT.',
  'Exports.xml':
    'Standard export invoice for goods or services supplied to a recipient outside the UAE. Zero-rated for VAT purposes.',
  'Margin scheme.xml':
    'For second-hand goods, collectibles, or antiques sold under the margin scheme. VAT is calculated on the profit margin rather than the full selling price.',
  'Standard invoice - Extensive.xml':
    'A comprehensive standard tax invoice with all optional fields populated. Use this as a reference for maximum-field scenarios.',
  'Standard invoice Mandatory fields.xml':
    'The minimum viable standard tax invoice — only mandatory UAE PINT AE fields. Ideal for validation testing with the smallest valid payload.',
  'Standard tax invoice - predefined endpoint.xml':
    'A standard tax invoice directed at a predefined EDI endpoint rather than a specific customer TRN lookup.',
  'Standard tax invoice.xml':
    'The standard UAE tax invoice with all mandatory fields. The most common invoice type — use this as your starting template.',
  'Summary tax invoice.xml':
    'A summary (or consolidated) tax invoice covering multiple transactions over a period. Used when several supplies are aggregated onto one document.',
  'Supply involving free trade zone.xml':
    'For supplies where either the supplier or customer is located in a UAE Free Trade Zone. Handles the special VAT treatment applicable to FTZ transactions.',
  'Supply through e-commerce.xml':
    'For electronic commerce supplies — digital goods, online services, or marketplace transactions where the platform may be deemed the supplier.',
  'Supply under Reverse charge mechanism.xml':
    'For B2B supplies where the customer accounts for VAT under the reverse charge mechanism. The supplier does not charge VAT; the customer self-assesses.',
  'Zero rated supplies.xml':
    'For zero-rated supplies (0% VAT) such as exports, international transport, and certain investment-grade precious metals.',
};

const FILENAMES = Object.keys(TEMPLATE_INFO).sort((a, b) => a.localeCompare(b));

export async function GET() {
  const templates: TemplateMeta[] = FILENAMES.map((filename) => ({
    filename,
    name: displayName(filename),
    description: TEMPLATE_INFO[filename],
  }));

  return NextResponse.json({ ok: true, templates });
}
</file>

<file path="web/src/app/api/tools/validate/batch/route.ts">
import { NextResponse } from 'next/server';
import { MAX_DOCUMENT_BYTES, validateDocument } from '@/lib/validation';
import { checkToolRateLimit, clientIp } from '@/lib/toolRateLimit';

export const runtime = 'nodejs';
export const dynamic = 'force-dynamic';

/**
 * POST /api/tools/validate/batch
 *
 * Batch validation endpoint — validates an array of invoices in one request.
 * Accepts the same document formats as the single-document endpoint (canonical
 * JSON, UBL 2.1 / PINT AE XML) and runs the same rule engine on each.
 *
 * Requests are subject to the same IP rate limit as the single-document
 * endpoint; each invoice in the batch consumes one unit of the hourly budget.
 *
 * Example request body:
 *   { "invoices": ["<Invoice>…</Invoice>", "{\"invoiceType\":\"388\",…}"] }
 *
 * Response shape:
 *   {
 *     "ok": true,
 *     "results": [
 *       { "index": 0, "valid": false, "errors": [...] },
 *       { "index": 1, "valid": true,  "errors": []    }
 *     ],
 *     "rateLimit": { ... }
 *   }
 */
const TOOL = 'uae-e-invoice-validator';

type BatchRequestBody = { invoices?: unknown };

type BatchItemResult = {
  index: number;
  valid: boolean;
  invoiceType: string | null;
  schemaVersion: string;
  errors: {
    path: string;
    rule: string;
    severity: 'error' | 'warning';
    message: string;
    fix?: string;
  }[];
};

type BatchItemError = {
  index: number;
  valid: false;
  invoiceType: null;
  schemaVersion: string;
  error: string;
};

export async function POST(request: Request) {
  let invoices: string[];

  try {
    const body = (await request.json()) as BatchRequestBody;
    const raw = body.invoices;
    if (!Array.isArray(raw)) {
      return NextResponse.json(
        { ok: false, error: '"invoices" must be an array of strings.' },
        { status: 400 },
      );
    }
    invoices = raw.map((s) => (typeof s === 'string' ? s.trim() : ''));
  } catch {
    return NextResponse.json({ ok: false, error: 'Invalid JSON body.' }, { status: 400 });
  }

  if (invoices.length === 0) {
    return NextResponse.json(
      { ok: false, error: '"invoices" array must contain at least one document.' },
      { status: 400 },
    );
  }

  if (invoices.length > 50) {
    return NextResponse.json(
      { ok: false, error: 'Batch size exceeds maximum of 50 invoices per request.' },
      { status: 413 },
    );
  }

  // Check size of each document
  for (let i = 0; i < invoices.length; i++) {
    if (Buffer.byteLength(invoices[i], 'utf8') > MAX_DOCUMENT_BYTES) {
      return NextResponse.json(
        {
          ok: false,
          error: `Invoice at index ${i} is larger than ${Math.round(MAX_DOCUMENT_BYTES / 1024)} KB. Use the API for files this size.`,
        },
        { status: 413 },
      );
    }
  }

  const ip = clientIp(request);
  const limit = await checkToolRateLimit(TOOL, ip);

  if (limit.unavailable) {
    return NextResponse.json(
      {
        ok: false,
        error:
          'The free tool is temporarily unavailable (rate-limit store unreachable). Try again shortly, or use the API.',
      },
      { status: 503 },
    );
  }

  if (!limit.allowed) {
    return NextResponse.json(
      {
        ok: false,
        error: `Free-tool limit reached: ${limit.limit} validations per hour from one IP. It resets in ${Math.ceil(limit.resetSeconds / 60)} minutes — or run the same check through the API with no hourly cap.`,
        rateLimit: { limit: limit.limit, remaining: 0, resetSeconds: limit.resetSeconds },
      },
      { status: 429 },
    );
  }

  // Validate each invoice sequentially (can optimise with Promise.all later)
  const results: (BatchItemResult | BatchItemError)[] = [];

  for (let i = 0; i < invoices.length; i++) {
    const doc = invoices[i];
    if (!doc) {
      results.push({
        index: i,
        valid: false,
        invoiceType: null,
        schemaVersion: '',
        error: 'Empty document at this index.',
      });
      continue;
    }

    try {
      const result = validateDocument(doc);
      results.push({
        index: i,
        valid: result.valid,
        invoiceType: result.invoiceType,
        schemaVersion: result.schemaVersion,
        errors: result.errors,
      });
    } catch (e) {
      results.push({
        index: i,
        valid: false,
        invoiceType: null,
        schemaVersion: '',
        error: `Validation engine error: ${e instanceof Error ? e.message : 'Unknown error'}`,
      });
    }
  }

  return NextResponse.json({
    ok: true,
    results,
    rateLimit: {
      limit: limit.limit,
      remaining: limit.remaining,
      resetSeconds: limit.resetSeconds,
      degraded: limit.degraded,
    },
  });
}
</file>

