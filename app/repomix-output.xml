<file path="web/src/lib/rules/checks/currency.js">
import { err, warn } from '../error.js';
import { DOMESTIC_CURRENCY, ISO4217_RE } from '../codelists.js';

/**
 * Currency presence, ISO 4217 shape, and the UAE requirement that VAT be
 * accounted in AED.
 *
 * Cites: PINT AE IBR-005 / IBR-CL-04 (DocumentCurrencyCode must be a valid
 * ISO 4217 alpha-3 code); UAE Guidelines v1.1 — VAT amounts must be reported
 * in AED, and a tax accounting currency (AED) is required when the invoice
 * currency is not AED (PINT IBR-053 / IBR-077).
 */
export const currencyRule = {
  id: 'ENG-CUR-01',
  spec: 'IBR-005 / IBR-CL-04 / IBR-053 / IBR-077 (PINT AE); AED accounting',
  description: 'Document currency present + ISO 4217; AED tax currency when invoice currency is not AED.',
  evaluate(inv) {
    const out = [];
    const cur = inv.currency;
    if (!cur) {
      out.push(
        err('/currency', 'ENG-CUR-01/IBR-005',
          'Document currency code (BT-5) is missing.',
          'Provide a currency, e.g. "AED".')
      );
      return out;
    }
    if (!ISO4217_RE.test(String(cur))) {
      out.push(
        err('/currency', 'ENG-CUR-02/IBR-CL-04',
          `Currency "${cur}" is not a valid ISO 4217 alpha-3 code.`,
          'Use a 3-letter uppercase code such as "AED".')
      );
    }
    if (cur !== DOMESTIC_CURRENCY) {
      // Foreign-currency invoice: VAT must still be accounted in AED.
      if (inv.taxCurrency !== DOMESTIC_CURRENCY) {
        out.push(
          err('/taxCurrency', 'ENG-CUR-03/IBR-053',
            `Invoice currency is "${cur}" but the tax accounting currency is not AED.`,
            'Set taxCurrency to "AED" and report VAT amounts in AED (BT-6).')
        );
      } else {
        out.push(
          warn('/currency', 'ENG-CUR-04',
            `Invoice currency is "${cur}" (non-AED). Ensure the AED VAT accounting amount and exchange rate are supplied.`,
            'Confirm taxCurrency "AED" and the applicable FTA exchange rate.')
        );
      }
    }
    return out;
  },
};
</file>

<file path="web/src/lib/rules/checks/documentTotals.js">
import { err } from '../error.js';
import { moneyEq, round2, isNumber, fmt } from '../money.js';

/**
 * Document-level total arithmetic. Rule IDs below are the PINT AE / EN 16931
 * calculation rules confirmed from the PINT AE business-rule set
 * (https://docs.peppol.eu/poac/ae/v1.0.1/pint-ae/trn-invoice/businessrule/):
 *
 *   IBR-CO-10  sum of line net (ibt-106) = Σ line net (ibt-131)
 *   IBR-CO-13  total w/o tax (ibt-109)  = ibt-106 - allowances (ibt-107) + charges (ibt-108)
 *   IBR-CO-14  total tax (ibt-110)      = Σ tax category tax amount (ibt-117)
 *   IBR-CO-15  total w/ tax (ibt-112)   = ibt-109 + ibt-110
 *   IBR-CO-16  amount due (ibt-115)     = ibt-112 - prepaid (ibt-113) + rounding (ibt-114)
 */
export const documentTotalsRule = {
  id: 'ENG-TOT-01',
  spec: 'IBR-CO-10/13/14/15/16 (PINT AE)',
  description: 'Document totals reconcile: line sum, tax-exclusive, tax, tax-inclusive and payable amounts.',
  evaluate(inv) {
    const out = [];
    const t = inv.totals || {};
    const lines = inv.lines || [];
    const subtotals = inv.taxSubtotals || [];

    // IBR-CO-10
    if (isNumber(t.lineExtensionAmount) && lines.every((l) => isNumber(l.lineExtensionAmount))) {
      const sum = round2(lines.reduce((s, l) => s + Number(l.lineExtensionAmount), 0));
      if (!moneyEq(sum, t.lineExtensionAmount)) {
        out.push(err('/totals/lineExtensionAmount', 'ENG-TOT-10/IBR-CO-10',
          `Sum of line net amounts (BT-106) ${fmt(t.lineExtensionAmount)} does not equal Σ line nets (${fmt(sum)}).`,
          `Set totals.lineExtensionAmount to ${fmt(sum)}.`));
      }
    }

    // IBR-CO-13
    if (isNumber(t.lineExtensionAmount) && isNumber(t.taxExclusiveAmount)) {
      const expected = round2(
        Number(t.lineExtensionAmount) - Number(inv.allowanceTotal || 0) + Number(inv.chargeTotal || 0)
      );
      if (!moneyEq(expected, t.taxExclusiveAmount)) {
        out.push(err('/totals/taxExclusiveAmount', 'ENG-TOT-13/IBR-CO-13',
          `Tax-exclusive amount (BT-109) ${fmt(t.taxExclusiveAmount)} does not equal line sum - allowances + charges (${fmt(expected)}).`,
          `Set totals.taxExclusiveAmount to ${fmt(expected)}.`));
      }
    }

    // IBR-CO-14
    if (isNumber(t.taxAmount) && subtotals.length && subtotals.every((s) => isNumber(s.taxAmount))) {
      const sum = round2(subtotals.reduce((s, st) => s + Number(st.taxAmount), 0));
      if (!moneyEq(sum, t.taxAmount)) {
        out.push(err('/totals/taxAmount', 'ENG-TOT-14/IBR-CO-14',
          `Invoice total tax (BT-110) ${fmt(t.taxAmount)} does not equal Σ tax subtotal amounts (${fmt(sum)}).`,
          `Set totals.taxAmount to ${fmt(sum)}.`));
      }
    }

    // IBR-CO-15
    if (isNumber(t.taxExclusiveAmount) && isNumber(t.taxAmount) && isNumber(t.taxInclusiveAmount)) {
      const expected = round2(Number(t.taxExclusiveAmount) + Number(t.taxAmount));
      if (!moneyEq(expected, t.taxInclusiveAmount)) {
        out.push(err('/totals/taxInclusiveAmount', 'ENG-TOT-15/IBR-CO-15',
          `Tax-inclusive amount (BT-112) ${fmt(t.taxInclusiveAmount)} does not equal tax-exclusive + tax (${fmt(expected)}).`,
          `Set totals.taxInclusiveAmount to ${fmt(expected)}.`));
      }
    }

    // IBR-CO-16
    if (isNumber(t.taxInclusiveAmount) && isNumber(t.payableAmount)) {
      const expected = round2(
        Number(t.taxInclusiveAmount) - Number(inv.prepaidAmount || 0) + Number(inv.roundingAmount || 0)
      );
      if (!moneyEq(expected, t.payableAmount)) {
        out.push(err('/totals/payableAmount', 'ENG-TOT-16/IBR-CO-16',
          `Amount due (BT-115) ${fmt(t.payableAmount)} does not equal tax-inclusive - prepaid + rounding (${fmt(expected)}).`,
          `Set totals.payableAmount to ${fmt(expected)}.`));
      }
    }

    return out;
  },
};
</file>

<file path="web/src/lib/rules/checks/invoiceType.js">
import { err, warn } from '../error.js';
import { isKnownInvoiceType, INVOICE_TYPE_CODES } from '../codelists.js';

/**
 * BT-3 invoice type code detection + code-list membership.
 * Cites: UNCL1001 (BT-3) as adopted by PINT AE; UAE mandatory-fields v1.0.
 */
export const invoiceTypeRule = {
  id: 'ENG-TYPE-01',
  spec: 'BT-3 / UNCL1001 (PINT AE)',
  description: 'Invoice type code must be present and a recognised PINT AE type.',
  evaluate(inv) {
    const out = [];
    const code = inv.invoiceType;
    if (code === undefined || code === null || code === '') {
      out.push(
        err(
          '/invoiceType',
          'ENG-TYPE-01/BT-3',
          'Invoice type code (BT-3) is missing.',
          `Set invoiceType to one of: ${Object.keys(INVOICE_TYPE_CODES).join(', ')} (e.g. "388" for a tax invoice).`
        )
      );
      return out;
    }
    if (!isKnownInvoiceType(code)) {
      out.push(
        warn(
          '/invoiceType',
          'ENG-TYPE-01/BT-3',
          `Invoice type code "${code}" is not in the recognised PINT AE list.`,
          `Use a known code: ${Object.keys(INVOICE_TYPE_CODES).join(', ')}.`
        )
      );
    }
    return out;
  },
};
</file>

<file path="web/src/lib/rules/checks/lineArithmetic.js">
import { err } from '../error.js';
import { moneyEq, round2, isNumber, fmt } from '../money.js';

/**
 * Per-line net amount arithmetic:
 *   line net (BT-131) = quantity (BT-129) x unit price (BT-146)
 *                       - line allowance + line charge
 *
 * Cites: PINT AE BT-131 line net amount; EN 16931 BR-24/BR-CO-4 line
 * calculation as inherited by PINT AE.
 */
export const lineArithmeticRule = {
  id: 'ENG-LINE-01',
  spec: 'BT-131 line net = qty x price (EN 16931 BR-CO-4, PINT AE)',
  description: 'Each invoice line net amount equals quantity x unit price (± line allowance/charge).',
  evaluate(inv) {
    const out = [];
    (inv.lines || []).forEach((ln, i) => {
      const base = `/lines/${i}`;
      if (!isNumber(ln.quantity) || !isNumber(ln.unitPrice)) {
        if (!isNumber(ln.quantity)) {
          out.push(err(`${base}/quantity`, 'ENG-LINE-02/BT-129',
            'Line quantity (BT-129) is missing or not numeric.', 'Provide a numeric quantity.'));
        }
        if (!isNumber(ln.unitPrice)) {
          out.push(err(`${base}/unitPrice`, 'ENG-LINE-03/BT-146',
            'Line unit price (BT-146) is missing or not numeric.', 'Provide a numeric unit price.'));
        }
        return;
      }
      if (!isNumber(ln.lineExtensionAmount)) {
        out.push(err(`${base}/lineExtensionAmount`, 'ENG-LINE-04/BT-131',
          'Line net amount (BT-131) is missing.', 'Provide lineExtensionAmount.'));
        return;
      }
      const expected = round2(
        Number(ln.quantity) * Number(ln.unitPrice) - Number(ln.allowance || 0) + Number(ln.charge || 0)
      );
      if (!moneyEq(expected, ln.lineExtensionAmount)) {
        out.push(err(`${base}/lineExtensionAmount`, 'ENG-LINE-05/BT-131',
          `Line net amount ${fmt(ln.lineExtensionAmount)} does not equal quantity x unit price (${fmt(expected)}).`,
          `Set lineExtensionAmount to ${fmt(expected)} (= ${fmt(ln.quantity)} x ${fmt(ln.unitPrice)}).`));
      }
    });
    return out;
  },
};
</file>

<file path="web/src/lib/rules/checks/requiredFields.js">
import { err } from '../error.js';
import { isNumber } from '../money.js';

/**
 * Presence of the core mandatory fields of a UAE tax invoice (subset of the
 * 51 mandatory fields across invoice details, seller/buyer, document totals
 * and tax breakdown).
 *
 * Cites: UAE Electronic Invoice mandatory fields v1.0 (MoF, 23 Feb 2026);
 * PINT AE BT-1, BT-2, BT-27, BT-44, and the document-total group.
 */
export const requiredFieldsRule = {
  id: 'ENG-REQ-01',
  spec: 'UAE mandatory fields v1.0 (BT-1/BT-2/BT-27/BT-44/totals)',
  description: 'Core mandatory header, party and total fields must be present.',
  evaluate(inv) {
    const out = [];
    const require = (cond, path, rule, msg, fix) => {
      if (!cond) out.push(err(path, rule, msg, fix));
    };

    require(!!inv.invoiceNumber, '/invoiceNumber', 'ENG-REQ-01/BT-1',
      'Invoice number (BT-1) is missing.', 'Provide a unique invoice identifier.');
    require(!!inv.issueDate, '/issueDate', 'ENG-REQ-02/BT-2',
      'Invoice issue date (BT-2) is missing.', 'Provide the issue date in YYYY-MM-DD.');
    require(!!inv.supplier?.name, '/supplier/name', 'ENG-REQ-03/BT-27',
      'Seller name (BT-27) is missing.', 'Provide the registered supplier name.');
    require(!!inv.customer?.name, '/customer/name', 'ENG-REQ-04/BT-44',
      'Buyer name (BT-44) is missing.', 'Provide the buyer name.');

    require(inv.lines && inv.lines.length > 0, '/lines', 'ENG-REQ-05',
      'Invoice must contain at least one line item.', 'Add one or more invoice lines.');

    require(inv.taxSubtotals && inv.taxSubtotals.length > 0, '/taxSubtotals', 'ENG-REQ-06/BG-23',
      'VAT breakdown (BG-23) is missing.', 'Provide at least one tax subtotal (taxable amount, tax amount, category).');

    require(isNumber(inv.totals?.lineExtensionAmount), '/totals/lineExtensionAmount', 'ENG-REQ-07/BT-106',
      'Sum of line net amounts (BT-106) is missing.', 'Provide totals.lineExtensionAmount.');
    require(isNumber(inv.totals?.taxExclusiveAmount), '/totals/taxExclusiveAmount', 'ENG-REQ-08/BT-109',
      'Invoice total without tax (BT-109) is missing.', 'Provide totals.taxExclusiveAmount.');
    require(isNumber(inv.totals?.taxAmount), '/totals/taxAmount', 'ENG-REQ-09/BT-110',
      'Invoice total tax amount (BT-110) is missing.', 'Provide totals.taxAmount.');
    require(isNumber(inv.totals?.taxInclusiveAmount), '/totals/taxInclusiveAmount', 'ENG-REQ-10/BT-112',
      'Invoice total with tax (BT-112) is missing.', 'Provide totals.taxInclusiveAmount.');
    require(isNumber(inv.totals?.payableAmount), '/totals/payableAmount', 'ENG-REQ-11/BT-115',
      'Amount due for payment (BT-115) is missing.', 'Provide totals.payableAmount.');

    return out;
  },
};
</file>

<file path="web/src/lib/rules/checks/taxBreakdown.js">
import { err, warn } from '../error.js';
import { moneyEq, round2, isNumber, fmt } from '../money.js';

/**
 * VAT breakdown consistency (per category):
 *   - category tax amount (BT-117) = category taxable amount (BT-116) x rate/100
 *     (EN 16931 BR-S-09 / BR-Z-* etc., inherited by PINT AE)
 *   - category taxable amount (BT-116) reconciles to the sum of line net
 *     amounts carrying that category (EN 16931 BR-S-08). When document-level
 *     allowances/charges are present the clean line-sum reconciliation is
 *     ambiguous, so it is downgraded to a warning.
 */
export const taxBreakdownRule = {
  id: 'ENG-TAX-01',
  spec: 'EN 16931 BR-S-08 / BR-S-09 (PINT AE VAT breakdown)',
  description: 'Each VAT subtotal: tax = taxable x rate, and taxable reconciles to line nets of that category.',
  evaluate(inv) {
    const out = [];
    const subtotals = inv.taxSubtotals || [];
    const lines = inv.lines || [];
    const hasDocAdjust = Number(inv.allowanceTotal || 0) !== 0 || Number(inv.chargeTotal || 0) !== 0;

    // Net per category code from the lines.
    const netByCat = new Map();
    for (const l of lines) {
      const code = l.taxCategory?.code;
      if (code === undefined || !isNumber(l.lineExtensionAmount)) continue;
      netByCat.set(code, round2((netByCat.get(code) || 0) + Number(l.lineExtensionAmount)));
    }

    subtotals.forEach((st, i) => {
      const base = `/taxSubtotals/${i}`;
      const rate = st.category?.rate;
      const code = st.category?.code;

      // BR-S-09: tax = taxable x rate/100
      if (isNumber(st.taxableAmount) && isNumber(rate) && isNumber(st.taxAmount)) {
        const expectedTax = round2((Number(st.taxableAmount) * Number(rate)) / 100);
        if (!moneyEq(expectedTax, st.taxAmount)) {
          out.push(err(`${base}/taxAmount`, 'ENG-TAX-09/BR-S-09',
            `VAT subtotal tax ${fmt(st.taxAmount)} for category "${code}" does not equal taxable x rate (${fmt(expectedTax)}).`,
            `Set taxAmount to ${fmt(expectedTax)} (= ${fmt(st.taxableAmount)} x ${rate}%).`));
        }
      }

      // BR-S-08: taxable reconciles to line nets of the same category.
      if (isNumber(st.taxableAmount) && netByCat.has(code)) {
        const lineNet = netByCat.get(code);
        if (!moneyEq(lineNet, st.taxableAmount)) {
          const mk = hasDocAdjust ? warn : err;
          out.push(mk(`${base}/taxableAmount`, 'ENG-TAX-08/BR-S-08',
            `VAT taxable amount ${fmt(st.taxableAmount)} for category "${code}" does not equal the sum of its line nets (${fmt(lineNet)}).`,
            hasDocAdjust
              ? `Reconcile taxable amount with line nets ${fmt(lineNet)} plus any document-level allowance/charge allocated to category "${code}".`
              : `Set taxableAmount to ${fmt(lineNet)}.`));
        }
      }
    });

    return out;
  },
};
</file>

<file path="web/src/lib/rules/checks/trn.js">
import { err, warn } from '../error.js';

/**
 * UAE Tax Registration Number (TRN) checks.
 *
 * The FTA VAT TRN is a 15-digit numeric identifier (BT-31 seller / BT-48 buyer
 * tax registration identifier in PINT AE). Note: the Peppol *participant*
 * identifier uses the first 10 digits (the corporate-tax TIN); this preflight
 * validates the full 15-digit VAT TRN carried on the tax invoice.
 *
 * Cites: UAE E-Invoicing Guidelines v1.1; PINT AE BT-31 / BT-48;
 * FTA VAT TRN = 15 digits.
 */
const TRN_RE = /^\d{15}$/;

export const trnRule = {
  id: 'ENG-TRN-01',
  spec: 'BT-31 / BT-48 (PINT AE); FTA 15-digit TRN',
  description: 'Seller TRN mandatory and 15 numeric digits; buyer TRN 15 digits when present.',
  evaluate(inv) {
    const out = [];
    const sellerTrn = inv.supplier?.trn;
    if (!sellerTrn) {
      out.push(
        err(
          '/supplier/trn',
          'ENG-TRN-01/BT-31',
          'Seller Tax Registration Number (BT-31) is missing.',
          'Provide the 15-digit FTA VAT TRN of the supplier.'
        )
      );
    } else if (!TRN_RE.test(String(sellerTrn).trim())) {
      out.push(
        err(
          '/supplier/trn',
          'ENG-TRN-02/BT-31',
          `Seller TRN "${sellerTrn}" is not a valid 15-digit UAE TRN.`,
          'A UAE FTA VAT TRN is exactly 15 numeric digits (no spaces or letters).'
        )
      );
    }

    const buyerTrn = inv.customer?.trn;
    if (!buyerTrn) {
      out.push(
        warn(
          '/customer/trn',
          'ENG-TRN-03/BT-48',
          'Buyer Tax Registration Number (BT-48) is absent.',
          'For a B2B tax invoice, include the buyer 15-digit TRN. Omit only for B2C.'
        )
      );
    } else if (!TRN_RE.test(String(buyerTrn).trim())) {
      out.push(
        err(
          '/customer/trn',
          'ENG-TRN-04/BT-48',
          `Buyer TRN "${buyerTrn}" is not a valid 15-digit UAE TRN.`,
          'A UAE FTA VAT TRN is exactly 15 numeric digits.'
        )
      );
    }
    return out;
  },
};
</file>

<file path="web/src/lib/rules/checks/vatCategory.js">
import { err } from '../error.js';
import { VAT_CATEGORY_CODES, isKnownVatCategory } from '../codelists.js';

/**
 * VAT category code membership + rate consistency, on every invoice line and
 * every tax subtotal.
 *
 * Cites: AE VAT category code list (S, Z, E, O, AE, N) —
 *   https://docs.peppol.eu/poac/ae/v1.0.1/pint-ae/trn-invoice/codelist/Aligned-TaxCategoryCodes/ ;
 * EN 16931 VAT-category rules "BR-S", "BR-Z", "BR-E" as inherited by PINT AE
 * (standard rated => rate 5, zero rated => 0, exempt/out-of-scope => 0).
 */
function checkCategory(out, path, code, rate) {
  if (code === undefined || code === null || code === '') {
    out.push(err(path + '/code', 'ENG-VAT-01/BT-151',
      'VAT category code is missing.',
      `Provide one of: ${Object.keys(VAT_CATEGORY_CODES).join(', ')}.`));
    return;
  }
  if (!isKnownVatCategory(code)) {
    out.push(err(path + '/code', 'ENG-VAT-02/BT-151',
      `VAT category code "${code}" is not an AE-aligned category.`,
      `Use one of: ${Object.keys(VAT_CATEGORY_CODES).join(', ')}.`));
    return;
  }
  const expected = VAT_CATEGORY_CODES[code].expectedRate;
  if (rate === undefined || rate === null) {
    // Rate is required for rated categories (S/N); 0 is implied for Z/E/O/AE.
    if (expected !== 0) {
      out.push(err(path + '/rate', 'ENG-VAT-03/BT-152',
        `VAT rate is missing for category "${code}" (${VAT_CATEGORY_CODES[code].name}).`,
        `Set the rate to ${expected}.`));
    }
    return;
  }
  if (Number(rate) !== expected) {
    out.push(err(path + '/rate', 'ENG-VAT-04/BR-S/BR-Z/BR-E',
      `VAT category "${code}" (${VAT_CATEGORY_CODES[code].name}) must carry rate ${expected}, found ${rate}.`,
      `Correct the rate to ${expected} or change the category code.`));
  }
}

export const vatCategoryRule = {
  id: 'ENG-VAT-01',
  spec: 'AE VAT category code list; EN 16931 BR-S/BR-Z/BR-E (PINT AE)',
  description: 'Every line and tax subtotal uses an AE VAT category with a consistent rate.',
  evaluate(inv) {
    const out = [];
    (inv.lines || []).forEach((ln, i) => {
      checkCategory(out, `/lines/${i}/taxCategory`, ln.taxCategory?.code, ln.taxCategory?.rate);
    });
    (inv.taxSubtotals || []).forEach((st, i) => {
      checkCategory(out, `/taxSubtotals/${i}/category`, st.category?.code, st.category?.rate);
    });
    return out;
  },
};
</file>

<file path="web/src/lib/rules/codelists.js">
/**
 * UAE / PINT AE code lists.
 *
 * Sources (fetched July 2026):
 *  - AE VAT category codes: https://docs.peppol.eu/poac/ae/v1.0.1/pint-ae/trn-invoice/codelist/Aligned-TaxCategoryCodes/
 *  - UAE Electronic Invoicing Guidelines v1.1 (MoF, 01 June 2026)
 *  - UAE Electronic Invoice mandatory fields v1.0 (MoF, 23 Feb 2026)
 *
 * TODO(pint-ae-xsd): replace these hand-maintained lists with the genericode
 * code lists shipped inside the official PINT AE package once the machine
 * -readable .gc / XSD files are wired in.
 */

// AE-aligned VAT category codes (subset of UNCL5305 used by PINT AE).
export const VAT_CATEGORY_CODES = {
  S: { name: 'Standard rate', expectedRate: 5 },
  Z: { name: 'Zero rated', expectedRate: 0 },
  E: { name: 'Exempt from tax', expectedRate: 0 },
  O: { name: 'Services outside scope of tax', expectedRate: 0 },
  AE: { name: 'VAT reverse charge', expectedRate: 0 },
  N: { name: 'Standard rate additional VAT', expectedRate: 5 },
};

// UAE standard VAT rate (Federal Decree-Law No. 8 of 2017).
export const UAE_STANDARD_VAT_RATE = 5;

// Domestic settlement currency.
export const DOMESTIC_CURRENCY = 'AED';

// ISO 4217 alpha-3 shape (membership check is shape-based; full ISO table is
// out of scope for preflight — AED is the one that matters for UAE domestic).
export const ISO4217_RE = /^[A-Z]{3}$/;

// UNCL1001 invoice type codes recognised by PINT AE (BT-3).
export const INVOICE_TYPE_CODES = {
  380: 'Commercial invoice',
  381: 'Credit note',
  383: 'Debit note',
  386: 'Prepayment invoice',
  388: 'Tax invoice',
  389: 'Self-billed invoice',
};

// Credit-note document type codes (UBL CreditNote root / typeCode).
export const CREDIT_NOTE_TYPE_CODES = new Set(['381']);

export function isKnownVatCategory(code) {
  return Object.prototype.hasOwnProperty.call(VAT_CATEGORY_CODES, code);
}

export function isKnownInvoiceType(code) {
  return Object.prototype.hasOwnProperty.call(INVOICE_TYPE_CODES, String(code));
}
</file>

<file path="web/src/lib/rules/engine.js">
import { RULES } from './registry.js';
import { normalizeInput } from './normalize.js';

export const SCHEMA_VERSION_DEFAULT = 'urn:peppol:pint:billing-1@ae-1';

/**
 * Run the full preflight validation. Deterministic: same input -> same output.
 *
 * @returns {{ valid, invoiceType, schemaVersion, errors }}
 */
export function validateInvoice(body, contentType = '') {
  const { invoice, parseError } = normalizeInput(body, contentType);

  if (parseError) {
    return {
      valid: false,
      invoiceType: null,
      schemaVersion: SCHEMA_VERSION_DEFAULT,
      errors: [
        {
          path: '/',
          rule: 'ENG-PARSE-01',
          severity: 'error',
          message: `Could not parse invoice: ${parseError}`,
          fix: 'Send a canonical JSON invoice, or a valid UBL 2.1 / PINT AE XML document.',
        },
      ],
    };
  }

  const errors = [];
  for (const rule of RULES) {
    try {
      const produced = rule.evaluate(invoice) || [];
      for (const e of produced) errors.push(e);
    } catch (e) {
      // A rule crash must never take down the request; surface it deterministically.
      errors.push({
        path: '/',
        rule: `${rule.id}/INTERNAL`,
        severity: 'error',
        message: `Rule ${rule.id} failed to evaluate: ${e.message}`,
        fix: 'Check the field(s) referenced by this rule for malformed values.',
      });
    }
  }

  const valid = !errors.some((e) => e.severity === 'error');

  return {
    valid,
    invoiceType: invoice.invoiceType ?? null,
    schemaVersion: invoice.schemaVersion || SCHEMA_VERSION_DEFAULT,
    errors,
  };
}
</file>

<file path="web/src/lib/rules/error.js">
/**
 * Normalized validation-error object. Every rule emits errors in exactly this
 * shape so consumers (and the OpenAPI schema) see one stable contract.
 *
 *  path     - JSON pointer-ish path into the canonical invoice model
 *  rule     - stable rule identifier (our engine id + cited spec rule)
 *  severity - 'error' (invalidates) | 'warning' (advisory, still valid)
 *  message  - human-readable explanation
 *  fix      - concrete, copy-pasteable remediation hint
 */
export function err(path, rule, message, fix, severity = 'error') {
  return { path, rule, severity, message, fix };
}

export function warn(path, rule, message, fix) {
  return err(path, rule, message, fix, 'warning');
}
</file>

<file path="web/src/lib/rules/money.js">
/**
 * Deterministic money helpers. UAE e-invoicing amounts are carried to 2
 * decimal places (fils). All comparisons round both operands to 2 dp and
 * allow a half-fils tolerance so representation noise never trips a rule.
 */

export function round2(n) {
  if (n === null || n === undefined || Number.isNaN(Number(n))) return NaN;
  // Round half away from zero at 2 dp (avoids banker's-rounding surprises).
  const x = Number(n);
  return Math.sign(x) * Math.round((Math.abs(x) + Number.EPSILON) * 100) / 100;
}

const TOLERANCE = 0.005; // half a fils

export function moneyEq(a, b) {
  const ra = round2(a);
  const rb = round2(b);
  if (Number.isNaN(ra) || Number.isNaN(rb)) return false;
  return Math.abs(ra - rb) < TOLERANCE;
}

export function isNumber(n) {
  return n !== null && n !== undefined && n !== '' && !Number.isNaN(Number(n));
}

export function fmt(n) {
  return isNumber(n) ? round2(n).toFixed(2) : String(n);
}
</file>

<file path="web/src/lib/rules/normalize.js">
import { looksLikeXml, parseUblInvoice } from './xml.js';

/**
 * Coerce any accepted input into the canonical invoice model consumed by the
 * rule engine. Accepts:
 *   - a raw UBL 2.1 / PINT AE XML string
 *   - a canonical JSON invoice object (this API's documented invoice DTO)
 *   - a JSON envelope { format: 'xml', document: '<Invoice>...' }
 *
 * Returns { invoice, parseError }. parseError is set when the input could not
 * be parsed at all (so the route can answer with a single structural error
 * rather than a stack trace).
 */
export function normalizeInput(body, contentType = '') {
  try {
    if (typeof body === 'string') {
      if (looksLikeXml(body)) return { invoice: parseUblInvoice(body) };
      // A JSON string body
      return { invoice: fromJson(JSON.parse(body)) };
    }
    if (body && typeof body === 'object') {
      if (typeof body.document === 'string' && looksLikeXml(body.document)) {
        return { invoice: parseUblInvoice(body.document) };
      }
      if (typeof body.invoice === 'object' && body.invoice) {
        return { invoice: fromJson(body.invoice) };
      }
      return { invoice: fromJson(body) };
    }
    return { parseError: 'Empty or unsupported request body' };
  } catch (e) {
    return { parseError: e.message || 'Failed to parse invoice' };
  }
}

function n(v) {
  if (v === undefined || v === null || v === '') return undefined;
  const x = Number(v);
  return Number.isNaN(x) ? undefined : x;
}

/** Map a canonical JSON invoice DTO to the internal model, filling defaults. */
function fromJson(obj) {
  const lines = Array.isArray(obj.lines) ? obj.lines : [];
  return {
    format: 'json',
    root: String(obj.invoiceType) === '381' ? 'CreditNote' : 'Invoice',
    schemaVersion: obj.schemaVersion || 'urn:peppol:pint:billing-1@ae-1',
    invoiceType: obj.invoiceType !== undefined ? String(obj.invoiceType) : undefined,
    invoiceNumber: obj.invoiceNumber ?? obj.id,
    issueDate: obj.issueDate,
    currency: obj.currency,
    taxCurrency: obj.taxCurrency,
    supplier: {
      trn: obj.supplier?.trn,
      name: obj.supplier?.name,
    },
    customer: {
      trn: obj.customer?.trn,
      name: obj.customer?.name,
    },
    lines: lines.map((ln, i) => ({
      id: ln.id ?? String(i + 1),
      quantity: n(ln.quantity),
      unitPrice: n(ln.unitPrice),
      lineExtensionAmount: n(ln.lineExtensionAmount),
      allowance: n(ln.allowance) ?? 0,
      charge: n(ln.charge) ?? 0,
      taxCategory: {
        code: ln.taxCategory?.code,
        rate: n(ln.taxCategory?.rate),
      },
      itemName: ln.itemName,
    })),
    allowanceTotal: n(obj.allowanceTotal) ?? 0,
    chargeTotal: n(obj.chargeTotal) ?? 0,
    prepaidAmount: n(obj.prepaidAmount) ?? 0,
    roundingAmount: n(obj.roundingAmount) ?? 0,
    taxSubtotals: Array.isArray(obj.taxSubtotals)
      ? obj.taxSubtotals.map((st) => ({
          taxableAmount: n(st.taxableAmount),
          taxAmount: n(st.taxAmount),
          category: { code: st.category?.code, rate: n(st.category?.rate) },
        }))
      : [],
    totals: {
      lineExtensionAmount: n(obj.totals?.lineExtensionAmount),
      taxExclusiveAmount: n(obj.totals?.taxExclusiveAmount),
      taxAmount: n(obj.totals?.taxAmount),
      taxInclusiveAmount: n(obj.totals?.taxInclusiveAmount),
      payableAmount: n(obj.totals?.payableAmount),
    },
    _warnings: [],
  };
}
</file>

<file path="web/src/lib/rules/registry.js">
import { invoiceTypeRule } from './checks/invoiceType.js';
import { trnRule } from './checks/trn.js';
import { requiredFieldsRule } from './checks/requiredFields.js';
import { currencyRule } from './checks/currency.js';
import { vatCategoryRule } from './checks/vatCategory.js';
import { lineArithmeticRule } from './checks/lineArithmetic.js';
import { documentTotalsRule } from './checks/documentTotals.js';
import { taxBreakdownRule } from './checks/taxBreakdown.js';

/**
 * Ordered rule registry. Order is fixed for deterministic output. To add the
 * official UBL/PINT AE XSD + Schematron layer, register it here ahead of the
 * semantic rules (see TODO(pint-ae-xsd) in xml.js).
 */
export const RULES = [
  invoiceTypeRule,
  requiredFieldsRule,
  trnRule,
  currencyRule,
  vatCategoryRule,
  lineArithmeticRule,
  taxBreakdownRule,
  documentTotalsRule,
];

export function ruleCatalog() {
  return RULES.map((r) => ({ id: r.id, spec: r.spec, description: r.description }));
}
