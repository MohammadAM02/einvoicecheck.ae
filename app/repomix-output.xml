<file path="api/src/rules/checks/lineArithmetic.js">
import { err } from '../error.js';
import { moneyEq, round2, isNumber, fmt } from '../money.js';

/**
 * Per-line net amount arithmetic:
 *   line net (BT-131) = quantity (BT-129) x unit price (BT-146)
 *                       - line allowance + line charge
 *
 * Cites: PINT AE BT-131 line net amount; EN 16931 BR-24/BR-CO-4 line
 * calculation as inherited by PINT AE.
 */
export const lineArithmeticRule = {
  id: 'ENG-LINE-01',
  spec: 'BT-131 line net = qty x price (EN 16931 BR-CO-4, PINT AE)',
  description: 'Each invoice line net amount equals quantity x unit price (± line allowance/charge).',
  evaluate(inv) {
    const out = [];
    (inv.lines || []).forEach((ln, i) => {
      const base = `/lines/${i}`;
      if (!isNumber(ln.quantity) || !isNumber(ln.unitPrice)) {
        if (!isNumber(ln.quantity)) {
          out.push(err(`${base}/quantity`, 'ENG-LINE-02/BT-129',
            'Line quantity (BT-129) is missing or not numeric.', 'Provide a numeric quantity.'));
        }
        if (!isNumber(ln.unitPrice)) {
          out.push(err(`${base}/unitPrice`, 'ENG-LINE-03/BT-146',
            'Line unit price (BT-146) is missing or not numeric.', 'Provide a numeric unit price.'));
        }
        return;
      }
      if (!isNumber(ln.lineExtensionAmount)) {
        out.push(err(`${base}/lineExtensionAmount`, 'ENG-LINE-04/BT-131',
          'Line net amount (BT-131) is missing.', 'Provide lineExtensionAmount.'));
        return;
      }
      const expected = round2(
        Number(ln.quantity) * Number(ln.unitPrice) - Number(ln.allowance || 0) + Number(ln.charge || 0)
      );
      if (!moneyEq(expected, ln.lineExtensionAmount)) {
        out.push(err(`${base}/lineExtensionAmount`, 'ENG-LINE-05/BT-131',
          `Line net amount ${fmt(ln.lineExtensionAmount)} does not equal quantity x unit price (${fmt(expected)}).`,
          `Set lineExtensionAmount to ${fmt(expected)} (= ${fmt(ln.quantity)} x ${fmt(ln.unitPrice)}).`));
      }
    });
    return out;
  },
};
</file>

<file path="api/src/rules/checks/requiredFields.js">
import { err } from '../error.js';
import { isNumber } from '../money.js';

/**
 * Presence of the core mandatory fields of a UAE tax invoice (subset of the
 * 51 mandatory fields across invoice details, seller/buyer, document totals
 * and tax breakdown).
 *
 * Cites: UAE Electronic Invoice mandatory fields v1.0 (MoF, 23 Feb 2026);
 * PINT AE BT-1, BT-2, BT-27, BT-44, and the document-total group.
 */
export const requiredFieldsRule = {
  id: 'ENG-REQ-01',
  spec: 'UAE mandatory fields v1.0 (BT-1/BT-2/BT-27/BT-44/totals)',
  description: 'Core mandatory header, party and total fields must be present.',
  evaluate(inv) {
    const out = [];
    const require = (cond, path, rule, msg, fix) => {
      if (!cond) out.push(err(path, rule, msg, fix));
    };

    require(!!inv.invoiceNumber, '/invoiceNumber', 'ENG-REQ-01/BT-1',
      'Invoice number (BT-1) is missing.', 'Provide a unique invoice identifier.');
    require(!!inv.issueDate, '/issueDate', 'ENG-REQ-02/BT-2',
      'Invoice issue date (BT-2) is missing.', 'Provide the issue date in YYYY-MM-DD.');
    require(!!inv.supplier?.name, '/supplier/name', 'ENG-REQ-03/BT-27',
      'Seller name (BT-27) is missing.', 'Provide the registered supplier name.');
    require(!!inv.customer?.name, '/customer/name', 'ENG-REQ-04/BT-44',
      'Buyer name (BT-44) is missing.', 'Provide the buyer name.');

    require(inv.lines && inv.lines.length > 0, '/lines', 'ENG-REQ-05',
      'Invoice must contain at least one line item.', 'Add one or more invoice lines.');

    require(inv.taxSubtotals && inv.taxSubtotals.length > 0, '/taxSubtotals', 'ENG-REQ-06/BG-23',
      'VAT breakdown (BG-23) is missing.', 'Provide at least one tax subtotal (taxable amount, tax amount, category).');

    require(isNumber(inv.totals?.lineExtensionAmount), '/totals/lineExtensionAmount', 'ENG-REQ-07/BT-106',
      'Sum of line net amounts (BT-106) is missing.', 'Provide totals.lineExtensionAmount.');
    require(isNumber(inv.totals?.taxExclusiveAmount), '/totals/taxExclusiveAmount', 'ENG-REQ-08/BT-109',
      'Invoice total without tax (BT-109) is missing.', 'Provide totals.taxExclusiveAmount.');
    require(isNumber(inv.totals?.taxAmount), '/totals/taxAmount', 'ENG-REQ-09/BT-110',
      'Invoice total tax amount (BT-110) is missing.', 'Provide totals.taxAmount.');
    require(isNumber(inv.totals?.taxInclusiveAmount), '/totals/taxInclusiveAmount', 'ENG-REQ-10/BT-112',
      'Invoice total with tax (BT-112) is missing.', 'Provide totals.taxInclusiveAmount.');
    require(isNumber(inv.totals?.payableAmount), '/totals/payableAmount', 'ENG-REQ-11/BT-115',
      'Amount due for payment (BT-115) is missing.', 'Provide totals.payableAmount.');

    return out;
  },
};
</file>

<file path="api/src/rules/checks/taxBreakdown.js">
import { err, warn } from '../error.js';
import { moneyEq, round2, isNumber, fmt } from '../money.js';

/**
 * VAT breakdown consistency (per category):
 *   - category tax amount (BT-117) = category taxable amount (BT-116) x rate/100
 *     (EN 16931 BR-S-09 / BR-Z-* etc., inherited by PINT AE)
 *   - category taxable amount (BT-116) reconciles to the sum of line net
 *     amounts carrying that category (EN 16931 BR-S-08). When document-level
 *     allowances/charges are present the clean line-sum reconciliation is
 *     ambiguous, so it is downgraded to a warning.
 */
export const taxBreakdownRule = {
  id: 'ENG-TAX-01',
  spec: 'EN 16931 BR-S-08 / BR-S-09 (PINT AE VAT breakdown)',
  description: 'Each VAT subtotal: tax = taxable x rate, and taxable reconciles to line nets of that category.',
  evaluate(inv) {
    const out = [];
    const subtotals = inv.taxSubtotals || [];
    const lines = inv.lines || [];
    const hasDocAdjust = Number(inv.allowanceTotal || 0) !== 0 || Number(inv.chargeTotal || 0) !== 0;

    // Net per category code from the lines.
    const netByCat = new Map();
    for (const l of lines) {
      const code = l.taxCategory?.code;
      if (code === undefined || !isNumber(l.lineExtensionAmount)) continue;
      netByCat.set(code, round2((netByCat.get(code) || 0) + Number(l.lineExtensionAmount)));
    }

    subtotals.forEach((st, i) => {
      const base = `/taxSubtotals/${i}`;
      const rate = st.category?.rate;
      const code = st.category?.code;

      // BR-S-09: tax = taxable x rate/100
      if (isNumber(st.taxableAmount) && isNumber(rate) && isNumber(st.taxAmount)) {
        const expectedTax = round2((Number(st.taxableAmount) * Number(rate)) / 100);
        if (!moneyEq(expectedTax, st.taxAmount)) {
          out.push(err(`${base}/taxAmount`, 'ENG-TAX-09/BR-S-09',
            `VAT subtotal tax ${fmt(st.taxAmount)} for category "${code}" does not equal taxable x rate (${fmt(expectedTax)}).`,
            `Set taxAmount to ${fmt(expectedTax)} (= ${fmt(st.taxableAmount)} x ${rate}%).`));
        }
      }

      // BR-S-08: taxable reconciles to line nets of the same category.
      if (isNumber(st.taxableAmount) && netByCat.has(code)) {
        const lineNet = netByCat.get(code);
        if (!moneyEq(lineNet, st.taxableAmount)) {
          const mk = hasDocAdjust ? warn : err;
          out.push(mk(`${base}/taxableAmount`, 'ENG-TAX-08/BR-S-08',
            `VAT taxable amount ${fmt(st.taxableAmount)} for category "${code}" does not equal the sum of its line nets (${fmt(lineNet)}).`,
            hasDocAdjust
              ? `Reconcile taxable amount with line nets ${fmt(lineNet)} plus any document-level allowance/charge allocated to category "${code}".`
              : `Set taxableAmount to ${fmt(lineNet)}.`));
        }
      }
    });

    return out;
  },
};
</file>

<file path="api/src/rules/checks/trn.js">
import { err, warn } from '../error.js';

/**
 * UAE Tax Registration Number (TRN) checks.
 *
 * The FTA VAT TRN is a 15-digit numeric identifier (BT-31 seller / BT-48 buyer
 * tax registration identifier in PINT AE). Note: the Peppol *participant*
 * identifier uses the first 10 digits (the corporate-tax TIN); this preflight
 * validates the full 15-digit VAT TRN carried on the tax invoice.
 *
 * Cites: UAE E-Invoicing Guidelines v1.1; PINT AE BT-31 / BT-48;
 * FTA VAT TRN = 15 digits.
 */
const TRN_RE = /^\d{15}$/;

export const trnRule = {
  id: 'ENG-TRN-01',
  spec: 'BT-31 / BT-48 (PINT AE); FTA 15-digit TRN',
  description: 'Seller TRN mandatory and 15 numeric digits; buyer TRN 15 digits when present.',
  evaluate(inv) {
    const out = [];
    const sellerTrn = inv.supplier?.trn;
    if (!sellerTrn) {
      out.push(
        err(
          '/supplier/trn',
          'ENG-TRN-01/BT-31',
          'Seller Tax Registration Number (BT-31) is missing.',
          'Provide the 15-digit FTA VAT TRN of the supplier.'
        )
      );
    } else if (!TRN_RE.test(String(sellerTrn).trim())) {
      out.push(
        err(
          '/supplier/trn',
          'ENG-TRN-02/BT-31',
          `Seller TRN "${sellerTrn}" is not a valid 15-digit UAE TRN.`,
          'A UAE FTA VAT TRN is exactly 15 numeric digits (no spaces or letters).'
        )
      );
    }

    const buyerTrn = inv.customer?.trn;
    if (!buyerTrn) {
      out.push(
        warn(
          '/customer/trn',
          'ENG-TRN-03/BT-48',
          'Buyer Tax Registration Number (BT-48) is absent.',
          'For a B2B tax invoice, include the buyer 15-digit TRN. Omit only for B2C.'
        )
      );
    } else if (!TRN_RE.test(String(buyerTrn).trim())) {
      out.push(
        err(
          '/customer/trn',
          'ENG-TRN-04/BT-48',
          `Buyer TRN "${buyerTrn}" is not a valid 15-digit UAE TRN.`,
          'A UAE FTA VAT TRN is exactly 15 numeric digits.'
        )
      );
    }
    return out;
  },
};
</file>

<file path="api/src/rules/checks/vatCategory.js">
import { err } from '../error.js';
import { VAT_CATEGORY_CODES, isKnownVatCategory } from '../codelists.js';

/**
 * VAT category code membership + rate consistency, on every invoice line and
 * every tax subtotal.
 *
 * Cites: AE VAT category code list (S, Z, E, O, AE, N) —
 *   https://docs.peppol.eu/poac/ae/v1.0.1/pint-ae/trn-invoice/codelist/Aligned-TaxCategoryCodes/ ;
 * EN 16931 VAT-category rules "BR-S", "BR-Z", "BR-E" as inherited by PINT AE
 * (standard rated => rate 5, zero rated => 0, exempt/out-of-scope => 0).
 */
function checkCategory(out, path, code, rate) {
  if (code === undefined || code === null || code === '') {
    out.push(err(path + '/code', 'ENG-VAT-01/BT-151',
      'VAT category code is missing.',
      `Provide one of: ${Object.keys(VAT_CATEGORY_CODES).join(', ')}.`));
    return;
  }
  if (!isKnownVatCategory(code)) {
    out.push(err(path + '/code', 'ENG-VAT-02/BT-151',
      `VAT category code "${code}" is not an AE-aligned category.`,
      `Use one of: ${Object.keys(VAT_CATEGORY_CODES).join(', ')}.`));
    return;
  }
  const expected = VAT_CATEGORY_CODES[code].expectedRate;
  if (rate === undefined || rate === null) {
    // Rate is required for rated categories (S/N); 0 is implied for Z/E/O/AE.
    if (expected !== 0) {
      out.push(err(path + '/rate', 'ENG-VAT-03/BT-152',
        `VAT rate is missing for category "${code}" (${VAT_CATEGORY_CODES[code].name}).`,
        `Set the rate to ${expected}.`));
    }
    return;
  }
  if (Number(rate) !== expected) {
    out.push(err(path + '/rate', 'ENG-VAT-04/BR-S/BR-Z/BR-E',
      `VAT category "${code}" (${VAT_CATEGORY_CODES[code].name}) must carry rate ${expected}, found ${rate}.`,
      `Correct the rate to ${expected} or change the category code.`));
  }
}

export const vatCategoryRule = {
  id: 'ENG-VAT-01',
  spec: 'AE VAT category code list; EN 16931 BR-S/BR-Z/BR-E (PINT AE)',
  description: 'Every line and tax subtotal uses an AE VAT category with a consistent rate.',
  evaluate(inv) {
    const out = [];
    (inv.lines || []).forEach((ln, i) => {
      checkCategory(out, `/lines/${i}/taxCategory`, ln.taxCategory?.code, ln.taxCategory?.rate);
    });
    (inv.taxSubtotals || []).forEach((st, i) => {
      checkCategory(out, `/taxSubtotals/${i}/category`, st.category?.code, st.category?.rate);
    });
    return out;
  },
};
</file>

<file path="api/src/rules/codelists.js">
/**
 * UAE / PINT AE code lists.
 *
 * Sources (fetched July 2026):
 *  - AE VAT category codes: https://docs.peppol.eu/poac/ae/v1.0.1/pint-ae/trn-invoice/codelist/Aligned-TaxCategoryCodes/
 *  - UAE Electronic Invoicing Guidelines v1.1 (MoF, 01 June 2026)
 *  - UAE Electronic Invoice mandatory fields v1.0 (MoF, 23 Feb 2026)
 *
 * TODO(pint-ae-xsd): replace these hand-maintained lists with the genericode
 * code lists shipped inside the official PINT AE package once the machine
 * -readable .gc / XSD files are wired in.
 */

// AE-aligned VAT category codes (subset of UNCL5305 used by PINT AE).
export const VAT_CATEGORY_CODES = {
  S: { name: 'Standard rate', expectedRate: 5 },
  Z: { name: 'Zero rated', expectedRate: 0 },
  E: { name: 'Exempt from tax', expectedRate: 0 },
  O: { name: 'Services outside scope of tax', expectedRate: 0 },
  AE: { name: 'VAT reverse charge', expectedRate: 0 },
  N: { name: 'Standard rate additional VAT', expectedRate: 5 },
};

// UAE standard VAT rate (Federal Decree-Law No. 8 of 2017).
export const UAE_STANDARD_VAT_RATE = 5;

// Domestic settlement currency.
export const DOMESTIC_CURRENCY = 'AED';

// ISO 4217 alpha-3 shape (membership check is shape-based; full ISO table is
// out of scope for preflight — AED is the one that matters for UAE domestic).
export const ISO4217_RE = /^[A-Z]{3}$/;

// UNCL1001 invoice type codes recognised by PINT AE (BT-3).
export const INVOICE_TYPE_CODES = {
  380: 'Commercial invoice',
  381: 'Credit note',
  383: 'Debit note',
  386: 'Prepayment invoice',
  388: 'Tax invoice',
  389: 'Self-billed invoice',
};

// Credit-note document type codes (UBL CreditNote root / typeCode).
export const CREDIT_NOTE_TYPE_CODES = new Set(['381']);

export function isKnownVatCategory(code) {
  return Object.prototype.hasOwnProperty.call(VAT_CATEGORY_CODES, code);
}

export function isKnownInvoiceType(code) {
  return Object.prototype.hasOwnProperty.call(INVOICE_TYPE_CODES, String(code));
}
