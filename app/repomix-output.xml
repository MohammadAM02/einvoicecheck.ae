<file path="web/src/lib/toolRateLimit.ts">
import { createHash } from 'node:crypto';
import { getRedis } from './redis';

/**
 * IP rate limit for the zero-login free tool (/tools/uae-e-invoice-validator).
 *
 * Same Redis instance app/api uses for `plan:limits:*` and its per-key limiter;
 * we just own a different namespace: `tool:rl:<tool>:<ipHash>:<window>`.
 * Fixed window, INCR + EXPIRE - the same shape as the API's per-minute limiter.
 *
 * The IP is stored only as a salted SHA-256 prefix; the raw address is never
 * written to Redis (see /legal/privacy - we do not need the address itself).
 *
 * FAIL OPEN: if Redis is unreachable the request is allowed and `degraded` is
 * set, so the caller can say so plainly. Production must not silently disable
 * the limit: TOOL_RATE_LIMIT_REQUIRE_REDIS=true makes a Redis outage a hard 503
 * instead of an unlimited free tool.
 */

export const TOOL_RATE_LIMIT = Number(process.env.TOOL_RATE_LIMIT_PER_HOUR ?? 20);
export const TOOL_RATE_WINDOW_SECONDS = 3600;

export type RateLimitDecision = {
  allowed: boolean;
  limit: number;
  remaining: number;
  resetSeconds: number;
  /** Redis was unreachable; the limit could not be enforced for this request. */
  degraded: boolean;
  /** Redis was unreachable AND the deployment requires it -> caller must 503. */
  unavailable: boolean;
};

/** Best-effort client IP from the proxy chain (Railway / Vercel style headers). */
export function clientIp(request: Request): string {
  const forwarded = request.headers.get('x-forwarded-for');
  if (forwarded) return forwarded.split(',')[0]!.trim();
  return request.headers.get('x-real-ip')?.trim() || 'unknown';
}

function ipHash(ip: string): string {
  const salt = process.env.TOOL_RATE_LIMIT_SALT ?? 'einvoicecheck-tool';
  return createHash('sha256').update(`${salt}:${ip}`).digest('hex').slice(0, 24);
}

export function toolRateKey(tool: string, ip: string, now = Date.now()): string {
  const window = Math.floor(now / (TOOL_RATE_WINDOW_SECONDS * 1000));
  return `tool:rl:${tool}:${ipHash(ip)}:${window}`;
}

export async function checkToolRateLimit(tool: string, ip: string): Promise<RateLimitDecision> {
  const limit = TOOL_RATE_LIMIT;
  const key = toolRateKey(tool, ip);

  try {
    const redis = getRedis();
    const hits = await redis.incr(key);
    if (hits === 1) await redis.expire(key, TOOL_RATE_WINDOW_SECONDS);
    const ttl = await redis.ttl(key);
    return {
      allowed: hits <= limit,
      limit,
      remaining: Math.max(0, limit - hits),
      resetSeconds: ttl > 0 ? ttl : TOOL_RATE_WINDOW_SECONDS,
      degraded: false,
      unavailable: false,
    };
  } catch {
    const required = process.env.TOOL_RATE_LIMIT_REQUIRE_REDIS === 'true';
    return {
      allowed: !required,
      limit,
      remaining: 0,
      resetSeconds: TOOL_RATE_WINDOW_SECONDS,
      degraded: true,
      unavailable: required,
    };
  }
}
</file>

<file path="web/src/lib/usage.ts">
import type { Types } from 'mongoose';
import { connectMongo } from './db';
import { ApiKey, UsageEvent } from './models';
import { PLANS, type PlanId } from './plans';

export type UsagePoint = { date: string; valid: number; invalid: number; error: number; total: number };

export type UsageSummary = {
  days: UsagePoint[];
  totals: { today: number; last30Days: number; allTime: number };
  outcomes: { valid: number; invalid: number; error: number };
  quota: { plan: PlanId; monthlyQuota: number; used: number; remaining: number; overage: number };
};

function isoDay(d: Date): string {
  return d.toISOString().slice(0, 10);
}

/**
 * Usage, aggregated from the Mongo `UsageEvent` metering events app/api writes.
 * This collection is the SOURCE OF TRUTH for consumption — Dodo has no metering
 * primitive and we do not pretend otherwise.
 */
export async function usageSummary(
  userId: Types.ObjectId,
  plan: PlanId,
  windowDays = 30,
): Promise<UsageSummary> {
  await connectMongo();
  const keys = await ApiKey.find({ userId }).select('_id').lean();
  const keyIds = keys.map((k) => k._id);

  const now = new Date();
  const since = new Date(now.getTime() - (windowDays - 1) * 86_400_000);
  since.setUTCHours(0, 0, 0, 0);

  const [rows, allTime] = await Promise.all([
    keyIds.length
      ? UsageEvent.aggregate<{ _id: { day: string; outcome: string }; count: number }>([
          { $match: { keyId: { $in: keyIds }, timestamp: { $gte: since } } },
          {
            $group: {
              _id: {
                day: { $dateToString: { format: '%Y-%m-%d', date: '$timestamp' } },
                outcome: '$outcome',
              },
              count: { $sum: 1 },
            },
          },
        ])
      : Promise.resolve([]),
    keyIds.length ? UsageEvent.countDocuments({ keyId: { $in: keyIds } }) : Promise.resolve(0),
  ]);

  const byDay = new Map<string, UsagePoint>();
  for (let i = 0; i < windowDays; i += 1) {
    const d = new Date(since.getTime() + i * 86_400_000);
    byDay.set(isoDay(d), { date: isoDay(d), valid: 0, invalid: 0, error: 0, total: 0 });
  }
  const outcomes = { valid: 0, invalid: 0, error: 0 };

  for (const row of rows) {
    const point = byDay.get(row._id.day);
    const outcome = row._id.outcome as 'valid' | 'invalid' | 'error';
    if (point && outcome in point) {
      point[outcome] += row.count;
      point.total += row.count;
    }
    if (outcome in outcomes) outcomes[outcome] += row.count;
  }

  const days = [...byDay.values()];
  const todayKey = isoDay(now);
  const today = byDay.get(todayKey)?.total ?? 0;
  const last30Days = days.reduce((sum, d) => sum + d.total, 0);

  const monthlyQuota = PLANS[plan].monthlyQuota;
  return {
    days,
    totals: { today, last30Days, allTime },
    outcomes,
    quota: {
      plan,
      monthlyQuota,
      used: last30Days,
      remaining: Math.max(0, monthlyQuota - last30Days),
      overage: Math.max(0, last30Days - monthlyQuota),
    },
  };
}
</file>

