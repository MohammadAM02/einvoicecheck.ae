<file path="web/src/app/api/waitlist/route.ts">
import { NextResponse } from 'next/server';
import { appendFile, mkdir } from 'node:fs/promises';
import path from 'node:path';

export const runtime = 'nodejs';
export const dynamic = 'force-dynamic';

/**
 * Waitlist capture - STUB.
 *
 * TODO(E2): replace this file-backed append with the real signup path:
 *   1. persist the lead in the datastore shared with app/api (Mongo),
 *   2. create the account + issue an API key on confirmation (real auth),
 *   3. hand the lead to Dodo Payments checkout when billing goes live.
 *
 * Until then this is a plain file append. On Railway the container filesystem is
 * ephemeral, so E2 MUST swap the store before this is relied on for real leads.
 * No credentials are read or required by this route.
 */
const STORE_PATH = process.env.WAITLIST_STORE_PATH ?? path.join(process.cwd(), 'data', 'waitlist.jsonl');

const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

type Payload = {
  email?: unknown;
  company?: unknown;
  volume?: unknown;
  stack?: unknown;
  source?: unknown;
};

function asString(value: unknown, max = 200): string {
  return typeof value === 'string' ? value.trim().slice(0, max) : '';
}

export async function POST(request: Request) {
  let payload: Payload;
  try {
    payload = (await request.json()) as Payload;
  } catch {
    return NextResponse.json({ ok: false, error: 'Invalid JSON body.' }, { status: 400 });
  }

  const email = asString(payload.email, 254).toLowerCase();
  if (!EMAIL_RE.test(email)) {
    return NextResponse.json({ ok: false, error: 'Enter a valid email address.' }, { status: 400 });
  }

  const record = {
    email,
    company: asString(payload.company),
    volume: asString(payload.volume, 32),
    stack: asString(payload.stack),
    source: asString(payload.source, 64) || 'unknown',
    createdAt: new Date().toISOString(),
  };

  try {
    await mkdir(path.dirname(STORE_PATH), { recursive: true });
    await appendFile(STORE_PATH, `${JSON.stringify(record)}\n`, 'utf8');
  } catch {
    return NextResponse.json(
      { ok: false, error: 'Could not save your signup. Try again shortly.' },
      { status: 500 },
    );
  }

  return NextResponse.json({ ok: true });
}
</file>

<file path="web/src/app/api/webhooks/dodo/route.ts">
import { NextResponse } from 'next/server';
import { handleDodoWebhook } from '@/lib/billing';
import { BillingNotConfiguredError } from '@/lib/dodo';

/**
 * Dodo Payments webhook endpoint — https://einvoicecheck.ae/api/webhooks/dodo
 *
 * Standard Webhooks: HMAC-SHA256 over `webhook-id . webhook-timestamp . raw_body`.
 * The body MUST be read raw (request.text()) — any parsing/re-serialisation
 * changes the bytes and the HMAC no longer matches. `runtime = 'nodejs'` and
 * `dynamic = 'force-dynamic'` keep Next from caching or transforming it.
 *
 * Verification uses the SDK's unwrap(). The SDK's unverified (unsafe) unwrap
 * variant is never called anywhere in this codebase.
 * Idempotency key is `webhook-id`; replays are dropped with a 200.
 */
export const runtime = 'nodejs';
export const dynamic = 'force-dynamic';

export async function POST(request: Request) {
  const rawBody = await request.text();

  const headers: Record<string, string> = {};
  request.headers.forEach((value, key) => {
    headers[key.toLowerCase()] = value;
  });

  try {
    const result = await handleDodoWebhook(rawBody, headers);
    return NextResponse.json(
      {
        ok: result.status < 400,
        handled: result.handled,
        deduped: result.deduped,
        ...(result.type ? { type: result.type } : {}),
        ...(result.reason ? { reason: result.reason } : {}),
      },
      { status: result.status },
    );
  } catch (err) {
    if (err instanceof BillingNotConfiguredError) {
      return NextResponse.json({ ok: false, error: err.message }, { status: 503 });
    }
    // Return 500 so Dodo retries — the idempotency ledger makes that safe.
    return NextResponse.json({ ok: false, error: 'Webhook processing failed.' }, { status: 500 });
  }
}
</file>

<file path="web/src/app/api/webhooks/lemon/route.ts">
import { NextResponse } from 'next/server';
import { connectMongo } from '@/lib/db';
import { User, WebhookEvent, type UserDoc } from '@/lib/models';
import { publishPlanLimits } from '@/lib/ratelimit';
import {
  verifyLemonSignature,
  planForLemonVariant,
  LEMON_HANDLED_EVENTS,
  type LemonWebhookPayload,
  type LemonHandledEvent,
} from '@/lib/lemon';
import type { PlanId, SubscriptionStatus } from '@/lib/plans';

export const runtime = 'nodejs';
export const dynamic = 'force-dynamic';

type WebhookResult = {
  status: number;
  handled: boolean;
  deduped: boolean;
  type?: string;
  reason?: string;
};

async function resolveUser(payload: LemonWebhookPayload): Promise<UserDoc | null> {
  const customUserId = payload.meta?.custom_data?.user_id;
  if (customUserId) {
    const user = await User.findById(customUserId).lean<UserDoc>();
    if (user) return user;
  }

  const email = payload.data?.attributes?.user_email?.toLowerCase();
  if (email) {
    return User.findOne({ email }).lean<UserDoc>();
  }

  return null;
}

async function applyState(
  userId: string,
  set: Record<string, unknown>,
  plan: PlanId | null,
): Promise<void> {
  await User.updateOne({ _id: userId }, { $set: set });
  if (plan) await publishPlanLimits(userId as unknown as import('mongoose').Types.ObjectId, plan);
}

async function recordWebhook(webhookId: string, type: string): Promise<boolean> {
  try {
    await WebhookEvent.create({ webhookId, type });
    return true;
  } catch (err) {
    if ((err as { code?: number })?.code === 11000) return false;
    throw err;
  }
}

/**
 * Lemon Squeezy webhook handler.
 * Verifies HMAC signature, resolves the user, and applies subscription state.
 */
export async function POST(request: Request) {
  const rawBody = await request.text();
  const signature = request.headers.get('x-signature');

  if (!signature) {
    return NextResponse.json(
      { status: 400, handled: false, reason: 'missing x-signature header' },
      { status: 400 },
    );
  }

  // Verify signature
  try {
    const valid = verifyLemonSignature(rawBody, signature);
    if (!valid) {
      return NextResponse.json(
        { status: 401, handled: false, reason: 'invalid signature' },
        { status: 401 },
      );
    }
  } catch {
    return NextResponse.json(
      { status: 500, handled: false, reason: 'webhook secret not configured' },
      { status: 500 },
    );
  }

  let payload: LemonWebhookPayload;
  try {
    payload = JSON.parse(rawBody) as LemonWebhookPayload;
  } catch {
    return NextResponse.json(
      { status: 400, handled: false, reason: 'invalid JSON' },
      { status: 400 },
    );
  }

  const eventName = payload.meta?.event_name;
  const eventId = payload.data?.id;

  if (!eventName || !eventId) {
    return NextResponse.json(
      { status: 400, handled: false, reason: 'missing event_name or id' },
      { status: 400 },
    );
  }

  await connectMongo();

  // Dedup
  const already = await WebhookEvent.findOne({
    webhookId: `lemon_${eventId}`,
  }).lean();
  if (already) {
    return NextResponse.json({
      status: 200,
      handled: false,
      deduped: true,
      type: eventName,
    });
  }

  if (!(LEMON_HANDLED_EVENTS as readonly string[]).includes(eventName)) {
    await recordWebhook(`lemon_${eventId}`, eventName);
    return NextResponse.json({
      status: 200,
      handled: false,
      deduped: false,
      type: eventName,
      reason: 'ignored event',
    });
  }

  const user = await resolveUser(payload);
  if (!user) {
    await recordWebhook(`lemon_${eventId}`, eventName);
    return NextResponse.json({
      status: 200,
      handled: false,
      deduped: false,
      type: eventName,
      reason: 'no matching user',
    });
  }

  const attrs = payload.data?.attributes ?? {};
  const variantPlan = planForLemonVariant(attrs.variant_id ?? '');
  const plan: PlanId = variantPlan ?? user.plan ?? 'trial';

  switch (eventName as LemonHandledEvent) {
    case 'subscription_created':
    case 'subscription_payment_success': {
      await applyState(String(user._id), {
        plan,
        subscriptionStatus: 'active' satisfies SubscriptionStatus,
        lemonSubscriptionId: payload.data.id,
        lemonCustomerId: attrs.customer_id,
        cancelAtPeriodEnd: false,
      }, plan);
      break;
    }
    case 'subscription_updated': {
      const cancelled = attrs.cancelled;
      await applyState(String(user._id), {
        plan: cancelled ? 'trial' : plan,
        subscriptionStatus: cancelled
          ? ('cancelled' satisfies SubscriptionStatus)
          : ('active' satisfies SubscriptionStatus),
        lemonSubscriptionId: payload.data.id,
        lemonCustomerId: attrs.customer_id,
        cancelAtPeriodEnd: Boolean(attrs.cancelled),
      }, cancelled ? 'trial' : plan);
      break;
    }
    case 'subscription_cancelled':
    case 'subscription_expired': {
      await applyState(String(user._id), {
        plan: 'trial',
        subscriptionStatus: 'cancelled' satisfies SubscriptionStatus,
        cancelAtPeriodEnd: false,
      }, 'trial');
      break;
    }
    case 'subscription_payment_failed': {
      await applyState(String(user._id), {
        lastPaymentStatus: 'failed',
        lemonSubscriptionId: payload.data.id,
        lemonCustomerId: attrs.customer_id,
      }, null);
      break;
    }
  }

  await recordWebhook(`lemon_${eventId}`, eventName);

  return NextResponse.json({
    status: 200,
    handled: true,
    deduped: false,
    type: eventName,
  });
}
</file>

