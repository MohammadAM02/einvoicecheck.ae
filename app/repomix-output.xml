/* ============================================================
   einvoicecheck.ae — Design System v2
   Inspired by the redesign mockup + Framer/Linear/Stripe
   ============================================================ */

/* ---- Fonts (loaded via <link> in layout.tsx) ---- */
/* DM Sans: headings  |  Inter: body/UI  |  JetBrains Mono: code */

/* ---- TOKENS ---- */
:root {
  /* surfaces */
  --bg: #0B0F14;
  --bg-elevated: #0F151C;
  --bg-card: #131B26;
  --bg-card-hover: #182332;
  --bg-section-alt: #0D1219;

  /* ink */
  --ink: #E8EEF5;
  --ink-secondary: #9DB0C3;
  --ink-muted: #6B7F94;
  --ink-disabled: #3D5267;

  /* accent — teal, precise and intentional for a UAE compliance tool */
  --accent: #0EA5C4;
  --accent-hover: #1FBFDF;
  --accent-subtle: rgba(14, 165, 196, 0.12);
  --accent-glow: rgba(14, 165, 196, 0.25);

  /* semantic */
  --success: #34D399;
  --success-subtle: rgba(52, 211, 153, 0.15);
  --warn: #FBBF24;
  --warn-subtle: rgba(251, 191, 36, 0.12);
  --error: #F87171;
  --error-subtle: rgba(248, 113, 113, 0.12);

  /* borders */
  --border: #22303F;
  --border-accent: #0EA5C4;
  --border-subtle: rgba(34, 48, 63, 0.5);

  /* radii */
  --radius-sm: 8px;
  --radius-md: 12px;
  --radius-lg: 16px;
  --radius-xl: 20px;
  --radius-full: 9999px;

  /* type */
  --font-heading: 'DM Sans', system-ui, -apple-system, sans-serif;
  --font-body: 'Inter', system-ui, -apple-system, sans-serif;
  --font-code: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;

  /* spacing scale */
  --space-xs: 4px;
  --space-sm: 8px;
  --space-md: 16px;
  --space-lg: 24px;
  --space-xl: 32px;
  --space-2xl: 48px;
  --space-3xl: 64px;
  --space-4xl: 96px;
  --space-5xl: 128px;

  /* layout */
  --max-width: 1120px;
  --nav-height: 64px;
}

/* ---- RESET ---- */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

html {
  scroll-behavior: smooth;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

body {
  background: var(--bg);
  color: var(--ink);
  font-family: var(--font-body);
  font-size: 15px;
  line-height: 1.65;
  overflow-x: hidden;
}

/* ---- LINKS ---- */
a {
  color: var(--accent);
  text-decoration: none;
  transition: color 0.2s;
}
a:hover { color: var(--accent-hover); }

/* ---- CONTAINER ---- */
.container {
  max-width: var(--max-width);
  margin: 0 auto;
  padding: 0 var(--space-xl);
}
.container.narrow { max-width: 560px; }

/* ---- SECTIONS ---- */
section, .section {
  padding: var(--space-4xl) 0;
}
.section-alt { background: var(--bg-section-alt); }
.section-header {
  text-align: center;
  margin-bottom: var(--space-3xl);
}
.section-label {
  display: inline-block;
  font-family: var(--font-heading);
  font-size: 12px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 1.8px;
  color: var(--accent);
  margin-bottom: var(--space-md);
}
.section-title {
  font-family: var(--font-heading);
  font-size: 36px;
  font-weight: 700;
  letter-spacing: -0.8px;
  line-height: 1.2;
  color: var(--ink);
}
.section-subtitle {
  font-size: 16px;
  color: var(--ink-secondary);
  max-width: 560px;
  margin: var(--space-md) auto 0;
}

/* ---- HEADINGS ---- */
h1 {
  font-family: var(--font-heading);
  font-size: 56px;
  font-weight: 700;
  letter-spacing: -1.2px;
  line-height: 1.08;
  margin-bottom: var(--space-lg);
}
h2 {
  font-family: var(--font-heading);
  font-size: 32px;
  font-weight: 700;
  letter-spacing: -0.6px;
  margin-bottom: var(--space-md);
}
h3 {
  font-family: var(--font-heading);
  font-size: 20px;
  font-weight: 600;
  letter-spacing: -0.3px;
  margin-bottom: var(--space-sm);
}
p {
  color: var(--ink-secondary);
  margin-bottom: var(--space-md);
}
p.lead {
  font-size: 17px;
  line-height: 1.7;
  max-width: 560px;
}
strong { color: var(--ink); font-weight: 600; }

/* ---- BADGES ---- */
.badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 14px;
  border-radius: var(--radius-full);
  font-size: 13px;
  font-weight: 500;
  background: var(--accent-subtle);
  color: var(--accent);
  border: 1px solid rgba(14, 165, 196, 0.2);
  margin-bottom: var(--space-lg);
}

/* ---- BUTTONS ---- */
.btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 12px 26px;
  border-radius: var(--radius-sm);
  font-family: var(--font-body);
  font-size: 15px;
  font-weight: 600;
  text-decoration: none;
  transition: all 0.2s ease;
  cursor: pointer;
  border: none;
  line-height: 1;
}
.btn-primary {
  background: var(--accent);
  color: #fff !important;
  box-shadow: 0 0 0 1px rgba(14, 165, 196, 0.3);
}
.btn-primary:hover {
  background: var(--accent-hover);
  box-shadow: 0 0 32px var(--accent-glow);
  transform: translateY(-1px);
}
.btn-secondary {
  background: transparent;
  color: var(--ink) !important;
  border: 1px solid var(--border);
}
.btn-secondary:hover {
  border-color: var(--ink-secondary);
  background: rgba(255,255,255,0.04);
}
.btn-ghost {
  background: transparent;
  color: var(--ink-secondary) !important;
}
.btn-ghost:hover {
  color: var(--ink) !important;
}
.btn-danger {
  border-color: #7f1d1d;
  color: #fca5a5 !important;
}
.btn-danger:hover {
  background: rgba(127, 29, 29, 0.25);
}
.btn:disabled, .btn.disabled {
  opacity: 0.4;
  pointer-events: none;
}

/* ---- CARDS ---- */
.card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: var(--space-xl) var(--space-lg);
  transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
}
.card:hover {
  border-color: var(--accent);
  transform: translateY(-2px);
}
.card.highlight {
  border-color: var(--accent);
  box-shadow: 0 0 0 1px var(--accent), 0 12px 40px rgba(14, 165, 196, 0.08);
}

/* ---- NOTICE / GUARDRAIL ---- */
.notice {
  border: 1px solid rgba(251, 191, 36, 0.35);
  background: var(--warn-subtle);
  border-radius: var(--radius-md);
  padding: var(--space-md) var(--space-lg);
  margin: var(--space-lg) 0;
}
.notice strong {
  color: var(--warn);
  font-size: 14px;
}
.notice p {
  margin: 6px 0 0;
  font-size: 14px;
  color: #e6d8b4;
}

/* ---- CODE BLOCKS ---- */
pre {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: var(--space-lg);
  overflow-x: auto;
  font-family: var(--font-code);
  font-size: 13px;
  line-height: 1.7;
  color: var(--ink-secondary);
}
code {
  font-family: var(--font-code);
  font-size: 0.9em;
  color: var(--accent);
  background: var(--accent-subtle);
  padding: 1px 6px;
  border-radius: 4px;
}
pre code {
  color: inherit;
  background: none;
  padding: 0;
  border-radius: 0;
}

/* ---- TABLES ---- */
table {
  width: 100%;
  border-collapse: separate;
  border-spacing: 0;
  border-radius: var(--radius-lg);
  overflow: hidden;
  border: 1px solid var(--border);
}
th {
  font-family: var(--font-heading);
  font-size: 13px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.8px;
  color: var(--ink-muted);
  text-align: left;
  padding: 14px 20px;
  background: rgba(255,255,255,0.02);
  border-bottom: 1px solid var(--border);
}
td {
  padding: 14px 20px;
  font-size: 14px;
  color: var(--ink-secondary);
  border-bottom: 1px solid rgba(34, 48, 63, 0.4);
}
tr:last-child td { border-bottom: none; }
tr:hover td { background: rgba(255,255,255,0.02); }

/* ---- FORMS ---- */
form.form {
  display: flex;
  flex-direction: column;
  gap: 6px;
}
form.form label {
  font-size: 0.88rem;
  color: var(--ink-muted);
}
form.form input,
form.form select,
form.form textarea,
.cta-row input {
  padding: 11px 12px;
  border-radius: 10px;
  border: 1px solid var(--border);
  background: var(--bg-elevated);
  color: var(--ink);
  font-size: 0.98rem;
  font-family: var(--font-body);
  transition: border-color 0.2s;
}
form.form input:focus,
form.form select:focus,
form.form textarea:focus {
  outline: none;
  border-color: var(--accent);
  box-shadow: 0 0 0 3px var(--accent-subtle);
}
form.form .btn {
  margin-top: 10px;
  align-self: flex-start;
}

/* ---- CTA ROW ---- */
.cta-row {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  margin-top: 22px;
}

/* ---- GRID ---- */
.grid {
  display: grid;
  gap: var(--space-lg);
}
.grid-2 { grid-template-columns: repeat(2, 1fr); }
.grid-3 { grid-template-columns: repeat(3, 1fr); }
.grid-4 { grid-template-columns: repeat(4, 1fr); }

/* ---- DIVIDER ---- */
.divider {
  width: 100%;
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--border), transparent);
}

/* ---- UTILITY ---- */
.text-muted { color: var(--ink-muted); }
.text-center { text-align: center; }
.mt-0 { margin-top: 0; }
.mt-sm { margin-top: var(--space-sm); }
.mt-md { margin-top: var(--space-md); }
.mt-lg { margin-top: var(--space-lg); }
.mb-0 { margin-bottom: 0; }
.mb-md { margin-bottom: var(--space-md); }
.mb-lg { margin-bottom: var(--space-lg); }

/* ---- KEYBOX ---- */
.keybox {
  display: block;
  overflow-x: auto;
  padding: 12px;
  margin: 10px 0;
  border: 1px solid var(--accent);
  border-radius: 10px;
  background: var(--bg);
  color: var(--accent);
  font-family: var(--font-code);
  font-size: 0.95rem;
}

/* ---- PILLS ---- */
.pill {
  display: inline-block;
  padding: 2px 9px;
  border-radius: var(--radius-full);
  border: 1px solid var(--border);
  font-size: 0.8rem;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  color: var(--ink-muted);
}
.pill-active { border-color: var(--accent); color: var(--accent); }
.pill-on_hold, .pill-failed { border-color: var(--warn); color: var(--warn); }
.pill-cancelled { border-color: #7f1d1d; color: var(--error); }

/* ---- STEPS ---- */
.steps { counter-reset: step; }
.steps .card { counter-increment: step; }
.steps .card h3::before {
  content: "0" counter(step);
  font-family: var(--font-heading);
  font-size: 48px;
  font-weight: 700;
  color: var(--accent);
  opacity: 0.15;
  display: block;
  line-height: 1;
  margin-bottom: -8px;
}

/* ---- LEGAL ---- */
.legal { max-width: 78ch; }
.legal h2 { margin-top: 34px; }
.legal h3 { margin-top: 22px; }
.legal ul { padding-left: 20px; }
.legal li { padding: 4px 0; color: var(--ink-secondary); }
.legal .meta { color: var(--ink-muted); font-size: 0.9rem; }

/* ---- DASHBOARD ---- */
.dash-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
  flex-wrap: wrap;
  margin-bottom: 20px;
}
.muted { color: var(--ink-muted); }
p.error, .error { color: var(--error); font-size: 0.95rem; }

/* ---- COMPARISON TABLES ---- */
p.source, .source { font-size: 0.84rem; color: var(--ink-muted); margin: 6px 0 0; }
.claim {
  border: 1px solid var(--border);
  border-left: 3px solid var(--accent);
  background: var(--bg-elevated);
  border-radius: var(--radius-md);
  padding: 14px 16px;
  margin: 16px 0;
}
.claim p { margin: 0; }
.claim .caveat { color: var(--ink-muted); font-size: 0.86rem; margin-top: 8px; }
table.compare th.rowhead { width: 30%; }
table.compare td.us { color: var(--ink); }
table.compare td.them-wins { color: var(--warn); }

/* ---- PLACEHOLDER (TODO markers) ---- */
mark.todo {
  background: #fef08a;
  color: #111827;
  font-weight: 600;
  padding: 1px 6px;
  border-radius: 4px;
  border: 1px dashed #a16207;
  font-size: 0.92em;
}

/* ---- FORM MESSAGES ---- */
.form-msg { font-size: 0.94rem; margin-top: 4px; }
.form-msg.ok { color: var(--success); }
.form-msg.err { color: var(--error); }

/* ============================================================
   NAV — glass morphism, scroll-aware
   ============================================================ */
header.site {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(11, 15, 20, 0.85);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid transparent;
  transition: border-color 0.3s ease;
}
header.site.scrolled {
  border-bottom-color: var(--border);
}
header.site .bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 14px 0;
  flex-wrap: wrap;
  max-width: var(--max-width);
  margin: 0 auto;
  padding-left: var(--space-xl);
  padding-right: var(--space-xl);
}
header.site .brand {
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: 18px;
  color: var(--ink);
  letter-spacing: -0.3px;
  text-decoration: none;
}
header.site .brand span { color: var(--accent); }
header.site .nav-links {
  display: flex;
  gap: 28px;
  align-items: center;
}
header.site nav {
  display: flex;
  gap: 24px;
  flex-wrap: wrap;
  align-items: center;
}
header.site nav a {
  color: var(--ink-secondary);
  font-size: 14px;
  font-weight: 500;
  transition: color 0.2s;
}
header.site nav a:hover {
  color: var(--ink);
  text-decoration: none;
}
header.site .nav-cta {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 8px 18px;
  background: var(--accent);
  color: #fff !important;
  border-radius: var(--radius-sm);
  font-weight: 600;
  font-size: 14px;
  transition: background 0.2s, box-shadow 0.2s;
}
header.site .nav-cta:hover {
  background: var(--accent-hover);
  box-shadow: 0 0 24px var(--accent-glow);
}

/* ---- FOOTER ---- */
footer.site {
  border-top: 1px solid var(--border);
  padding: var(--space-3xl) 0 var(--space-2xl);
  font-size: 0.92rem;
}
.footer-grid {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 1fr 1fr;
  gap: var(--space-2xl);
  margin-bottom: var(--space-2xl);
}
.footer-brand p {
  font-size: 13px;
  color: var(--ink-muted);
  margin-top: var(--space-md);
  max-width: 300px;
  line-height: 1.6;
}
.footer-col h5 {
  font-family: var(--font-heading);
  font-size: 12px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 1px;
  color: var(--ink-muted);
  margin-bottom: var(--space-md);
}
.footer-col a {
  display: block;
  font-size: 13px;
  color: var(--ink-secondary);
  text-decoration: none;
  padding: 4px 0;
  transition: color 0.2s;
}
.footer-col a:hover { color: var(--ink); }
.footer-bottom {
  padding-top: var(--space-lg);
  border-top: 1px solid var(--border);
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 13px;
  color: var(--ink-muted);
  flex-wrap: wrap;
  gap: var(--space-sm);
}
footer.site .fine {
  color: var(--ink-muted);
  max-width: 78ch;
  font-size: 0.86rem;
}

/* ============================================================
   ANIMATIONS
   ============================================================ */

/* Scroll reveal */
.scroll-reveal {
  opacity: 0;
  transform: translateY(24px);
  transition: opacity 0.6s ease-out, transform 0.6s ease-out;
}
.scroll-reveal.revealed {
  opacity: 1;
  transform: translateY(0);
}

/* Stagger delay utilities */
.scroll-reveal.delay-1 { transition-delay: 0.1s; }
.scroll-reveal.delay-2 { transition-delay: 0.2s; }
.scroll-reveal.delay-3 { transition-delay: 0.3s; }
.scroll-reveal.delay-4 { transition-delay: 0.4s; }

/* Fade in (no vertical movement) */
.fade-in {
  opacity: 0;
  transition: opacity 0.5s ease-out;
}
.fade-in.visible { opacity: 1; }

/* Hover lift */
.hover-lift {
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}
.hover-lift:hover {
  transform: translateY(-3px);
}

/* FAQ accordion */
.faq-list { max-width: 720px; margin: 0 auto; }
.faq-item { border-bottom: 1px solid var(--border); }
.faq-item:first-child { border-top: 1px solid var(--border); }
.faq-question {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  padding: var(--space-lg) 0;
  background: none;
  border: none;
  color: var(--ink);
  font-family: var(--font-body);
  font-size: 16px;
  font-weight: 500;
  text-align: left;
  cursor: pointer;
  transition: color 0.2s;
}
.faq-question:hover { color: var(--accent); }
.faq-question .arrow {
  flex-shrink: 0;
  width: 20px;
  height: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.25s ease;
  color: var(--ink-muted);
  font-size: 18px;
}
.faq-item.open .faq-question .arrow { transform: rotate(180deg); }
.faq-answer {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease, padding 0.3s ease;
}
.faq-item.open .faq-answer {
  max-height: 500px;
  padding-bottom: var(--space-lg);
}
.faq-answer-inner {
  font-size: 15px;
  color: var(--ink-secondary);
  line-height: 1.7;
}

/* ============================================================
   HERO
   ============================================================ */
.hero {
  padding: var(--space-5xl) 0 var(--space-4xl);
  position: relative;
  overflow: hidden;
}
.hero::before {
  content: '';
  position: absolute;
  top: -30%;
  right: -15%;
  width: 600px;
  height: 600px;
  background: radial-gradient(circle, var(--accent-glow) 0%, transparent 70%);
  pointer-events: none;
}
.hero-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-4xl);
  align-items: center;
}
.hero-left { position: relative; z-index: 1; }
.hero-badge { margin-bottom: var(--space-lg); }
.hero h1 .highlight { color: var(--accent); }
.hero p {
  font-size: 17px;
  color: var(--ink-secondary);
  line-height: 1.7;
  max-width: 480px;
  margin-bottom: var(--space-xl);
}
.hero-actions {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  margin-bottom: var(--space-lg);
}
.hero-stats {
  display: flex;
  gap: var(--space-2xl);
  margin-top: var(--space-lg);
  padding-top: var(--space-lg);
  border-top: 1px solid var(--border);
}
.stat-value {
  font-family: var(--font-heading);
  font-size: 28px;
  font-weight: 700;
  color: var(--ink);
  letter-spacing: -0.5px;
}
.stat-label {
  font-size: 13px;
  color: var(--ink-muted);
  margin-top: 2px;
}
/* hero right — code block */
.hero-right { position: relative; z-index: 1; }
.code-block {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: 0 8px 40px rgba(0,0,0,0.3);
}
.code-header {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 12px 16px;
  background: rgba(255,255,255,0.03);
  border-bottom: 1px solid var(--border);
}
.code-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
}
.code-dot:nth-child(1) { background: #EF4444; }
.code-dot:nth-child(2) { background: #F59E0B; }
.code-dot:nth-child(3) { background: #10B981; }
.code-body {
  padding: var(--space-lg);
  font-family: var(--font-code);
  font-size: 13px;
  line-height: 1.7;
  color: var(--ink-secondary);
  overflow-x: auto;
}
.code-body .kw { color: #C084FC; }
.code-body .str { color: #34D399; }
.code-body .key { color: #60A5FA; }
.code-body .cmt { color: #4A5B6E; font-style: italic; }
.code-body .err { color: #F87171; }
.code-body .fix { color: #FBBF24; }

/* ============================================================
   PRICING CARDS
   ============================================================ */
.pricing-grid {
  display: grid;
  grid-template-columns: 1fr 1.2fr 1fr;
  gap: var(--space-lg);
  align-items: start;
}
.pricing-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
