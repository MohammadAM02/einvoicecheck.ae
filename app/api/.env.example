# ---- UAE e-invoice preflight validation API : environment ----
# Copy to .env and fill in. Every var the service reads is listed here.

# HTTP
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=development

# MongoDB (Mongoose) — stores API keys + usage-metering events
MONGODB_URI=mongodb://127.0.0.1:27017/uae_einvoice_preflight

# Redis — backs per-API-key rate limiting (sliding window)
REDIS_URL=redis://127.0.0.1:6379

# Per-key rate limit (defaults; each key may override rateLimitPerMinute in Mongo)
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
# Keep false for local development. Railway production must set this to true.
RATE_LIMIT_REQUIRE_REDIS=false
