    "fastify": "^5.2.1",
    "ioredis": "^5.4.2",
    "mongoose": "^9.7.4"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.9",
    "ioredis-mock": "^8.9.0",
    "mongodb-memory-server": "^10.1.3",
    "vitest": "^2.1.9"
  },
