{
  "name": "uae-einvoice-preflight-api",
  "version": "1.0.0",
  "description": "UAE e-invoice preflight validation API — deterministic PINT AE / UBL 2.1 rule engine. Preflight validation only; not FTA-accredited, does not transmit legal e-invoices, does not replace an accredited ASP or provide statutory archival.",
